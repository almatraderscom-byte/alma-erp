// ─── Creative Studio Enterprise CSE5: owner voice lifecycle ────────────────
// Voice versions are append-only provider identities. Lifecycle changes never
// overwrite consent/provider identity: activation, revocation and provider
// deletion are recorded separately in the durable audit ledger.

model CreativeVoice {
  id              String                 @id @default(uuid())
  ownerId         String                 @map("owner_id")
  name            String
  provider        String                 @default("elevenlabs")
  ownerOnly       Boolean                @default(true) @map("owner_only")
