// ─── Creative Studio Enterprise CSE7: distribution and attribution ─────────
// Publishing is an owner-only, approved-version effect. The delivery row is the
// exactly-once ledger: an ambiguous Meta outcome is never retried automatically.

enum CreativePublishPlatform {
  FACEBOOK
  INSTAGRAM
}

enum CreativePublishStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED_RETRYABLE
  NEEDS_REVIEW
  CANCELED
}

model CreativePublishDelivery {
  id                       String                        @id @default(uuid())
  ownerId                  String                        @map("owner_id")
  brandProfileId           String                        @map("brand_profile_id")
  brandProfile             CreativeBrandProfile          @relation(fields: [brandProfileId], references: [id], onDelete: Restrict)
  projectId                String                        @map("project_id")
  project                  CreativeProject               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assetId                  String                        @map("asset_id")
  asset                    CreativeProjectAsset          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assetVersionId           String                        @map("asset_version_id")
  assetVersion             CreativeAssetVersion          @relation(fields: [assetVersionId], references: [id], onDelete: Restrict)
  recipeId                 String?                       @map("recipe_id")
  recipe                   CreativeBrandRecipe?          @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  campaignPackId           String?                       @map("campaign_pack_id")
  compositionId            String?                       @map("composition_id")
  composition              CreativeComposition?          @relation("CreativePublishComposition", fields: [compositionId, ownerId, brandProfileId, projectId], references: [id, ownerId, brandProfileId, projectId], onDelete: Restrict)
  compositionVersionId     String?                       @map("composition_version_id")
  compositionVersionRecord CreativeCompositionVersion?   @relation("CreativePublishCompositionVersion", fields: [compositionVersionId, compositionId, compositionVersion, compositionDocumentHash], references: [id, compositionId, version, documentHash], onDelete: Restrict)
  compositionVersion       Int?                          @map("composition_version")
  compositionDocumentHash  String?                       @map("composition_document_hash")
  operationBatchId         String?                       @map("operation_batch_id")
  operationBatch           CreativeOperationBatch?       @relation("CreativePublishOperationBatch", fields: [operationBatchId, compositionId, compositionVersion], references: [id, compositionId, resultVersion], onDelete: Restrict)
  reviewFingerprint        String?                       @map("review_fingerprint")
  renderFingerprint        String?                       @map("render_fingerprint")
  sceneKey                 String                        @default("unclassified") @map("scene_key")
  approvedReviewEventId    String                        @map("approved_review_event_id")
  approvedReviewEvent      CreativeAssetReviewEvent      @relation(fields: [approvedReviewEventId], references: [id], onDelete: Restrict)
  createdById              String                        @map("created_by_id")
  platform                 CreativePublishPlatform
  pageRef                  String                        @map("page_ref")
  caption                  String                        @db.Text
  mediaStoragePath         String                        @map("media_storage_path") @db.Text
  adId                     String?                       @map("ad_id")
  idempotencyKey           String                        @map("idempotency_key")
  requestFingerprint       String                        @map("request_fingerprint")
  status                   CreativePublishStatus         @default(SCHEDULED)
  scheduledFor             DateTime                      @map("scheduled_for")
  attempts                 Int                           @default(0)
  leaseStartedAt           DateTime?                     @map("lease_started_at")
  nextAttemptAt            DateTime?                     @map("next_attempt_at")
  externalPostId           String?                       @map("external_post_id")
  permalinkUrl             String?                       @map("permalink_url") @db.Text
  verifiedAt               DateTime?                     @map("verified_at")
  publishedAt              DateTime?                     @map("published_at")
  receipt                  Json                          @default("{}")
  lastErrorCode            String?                       @map("last_error_code")
  lastErrorMessage         String?                       @map("last_error_message") @db.Text
  metricsLastSyncedAt      DateTime?                     @map("metrics_last_synced_at")
  metricsNextSyncAt        DateTime?                     @map("metrics_next_sync_at")
  metricsLastError         String?                       @map("metrics_last_error") @db.Text
  costUsd                  Decimal                       @default(0) @map("cost_usd") @db.Decimal(10, 6)
  createdAt                DateTime                      @default(now()) @map("created_at")
  updatedAt                DateTime                      @updatedAt @map("updated_at")
  performanceSnapshots     CreativePerformanceSnapshot[]

  @@unique([ownerId, idempotencyKey])
  @@index([status, scheduledFor])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([brandProfileId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([assetId, createdAt(sort: Desc)])
  @@index([campaignPackId])
  @@index([metricsNextSyncAt])
  @@index([compositionId, compositionVersionId])
  @@index([operationBatchId, compositionId, compositionVersion])
  @@index([approvedReviewEventId])
  @@map("creative_publish_deliveries")
}

