  @@index([date, waqt])
  @@map("salah_overrides")
}

model AgentKvSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("agent_kv_settings")
}

/// The SIP provider's own panel credential, for the ONE thing only their side can answer:
/// which PBX currently holds the registration binding. Our own Asterisk has reported
/// "Registered (exp. 3227s)" while their table did not list us at all, and believing our
/// side cost roughly half of all outbound calls for days.
///
/// Deliberately NOT in `agent_kv_settings`: the agent's own `get_settings` tool dumps that
/// whole table, and a third party's password has no business passing through a model's
/// context. The secret is stored AES-256-GCM encrypted and is never returned by any route.
model PhoneProviderCredential {
  id          String    @id @default("amarip")
  username    String
  secretEnc   String    @map("secret_enc") @db.Text
  loginUrl    String?   @map("login_url")
  statusUrl   String?   @map("status_url")
  lastCheckAt DateTime? @map("last_check_at")
  lastCheckOk Boolean?  @map("last_check_ok")
  lastError   String?   @map("last_error") @db.Text
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("phone_provider_credentials")
}

// Skill Engine V2 (B4): one row per imported GitHub skill VERSION (pinned commit).
// A `block`-verdict import is quarantined (status 'blocked') and never goes live;
// clean imports move draft → reviewed → canary → active, with rollback via `supersedes`.
model AgentImportedSkill {
  id           String   @id
  name         String
  sourceRepo   String   @map("source_repo")
  sourceCommit String   @map("source_commit")
  contentHash  String   @map("content_hash")
  status       String // blocked|draft|reviewed|canary|active|retired
  verdict      String // block|review|ok
  findings     Json?
  reviewedBy   String?  @map("reviewed_by")
  supersedes   String?  @map("supersedes") // id of the prior active version (rollback target)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([name, sourceCommit])
  @@index([name, status])
  @@map("agent_imported_skills")
}

// Phase 42 — versioned Growth Brain. One row per brief VERSION; history is
// never rewritten. Exactly one 'approved' row per business at a time (older
// approved rows become 'superseded'). `brief` holds GrowthBriefContent with
// facts / inference / recommendation / owner decision kept separate.
model AgentGrowthBrief {
  id           String    @id @default(uuid())
  businessId   String    @default("ALMA_LIFESTYLE")
  version      Int
  status       String    @default("draft") // draft | approved | superseded | rejected
  brief        Json
  /// Why this version exists (required from v2 onward — explains what changed).
  changeReason String?   @db.Text
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([businessId, version])
  @@index([businessId, status])
  @@map("agent_growth_briefs")
}

// Phase 43 — marketing event ledger. One row per logical event; eventId is the
// deterministic dedup key shared with browser Pixel + Meta CAPI. A duplicate
// arrival is stored as status=deduped (never re-sent, never double-counted).
model AgentMarketingEvent {
  id         String   @id @default(uuid())
  eventName  String
  eventId    String   @unique
  source     String // browser | server | erp | import
  occurredAt DateTime
  currency   String   @default("BDT")
  /// Whole taka.
  valueBdt   Int?
  orderId    String?
  utm        Json?
  status     String   @default("queued") // queued | sent | failed | deduped | test
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([eventName, occurredAt])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("agent_marketing_events")
}

// Phase 44 — growth experiment registry. Every marketing asset/campaign/CRO
// change belongs to one experiment with an explicit hypothesis, sample floor,
// and winner/loser rules. Outcomes + learnings feed future decisions.
model AgentGrowthExperiment {
  id           String    @id @default(uuid())
  businessId   String    @default("ALMA_LIFESTYLE")
  name         String
  status       String    @default("draft") // draft | approved | running | stopped | won | lost | inconclusive
  hypothesis   Json // ExperimentHypothesis (experiment-registry.ts)
  /// Growth-brief version this experiment serves (traceability to strategy).
  briefVersion Int?
  startAt      DateTime?
  endAt        DateTime?
  outcome      Json?
  learning     String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId, status])
  @@map("agent_growth_experiments")
}

// Phase E (live browser companion) — a paired Chrome (the owner's own browser
// running the ALMA Companion extension). The agent drives it live via the
// command queue below. Token is stored hashed; pairing uses a short-lived code.
model LiveBrowserDevice {
  id          String    @id @default(uuid())
  ownerUserId String
  name        String    @default("My Chrome")
  /// sha256(token) — the raw token only ever lives in the extension.
  tokenHash   String?   @unique
  /// one-time pairing code + expiry (cleared once paired).
  pairingCode String?   @unique
  pairingExp  DateTime?
  pairedAt    DateTime?
  lastSeenAt  DateTime?
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  commands LiveBrowserCommand[]

  @@index([ownerUserId])
  @@map("live_browser_devices")
}

// One command the agent wants the paired browser to run (navigate/read/click/…)
// Durable queue (never in-memory): extension polls 'queued', posts result back.
model LiveBrowserCommand {
  id          String            @id @default(uuid())
  deviceId    String
  device      LiveBrowserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action      String
  params      Json?
  /// queued → delivered → done | failed
  status      String            @default("queued")
  result      Json?
  error       String?           @db.Text
  createdAt   DateTime          @default(now())
  deliveredAt DateTime?
  resolvedAt  DateTime?

  @@index([deviceId, status])
  /// Same live-dock poll (see mac_agent_commands).
  @@index([createdAt])
  @@map("live_browser_commands")
}

// M1 (Mac control) — the owner's own Mac running the ALMA Mac Agent daemon.
// Same shape and same safety posture as LiveBrowserDevice above: pull-based, no
// inbound port on the Mac, token stored hashed, one-time pairing code.
model MacAgentDevice {
  id          String    @id @default(uuid())
  ownerUserId String
  name        String    @default("My Mac")
  /// sha256(token) — the raw token only ever lives on the Mac.
  tokenHash   String?   @unique
  pairingCode String?   @unique
  pairingExp  DateTime?
  pairedAt    DateTime?
  lastSeenAt  DateTime?
  revoked     Boolean   @default(false)
  /// Daemon-reported facts (hostname, agent version, node version) for the status page.
  meta        Json?
  createdAt   DateTime  @default(now())

  commands MacAgentCommand[]

  @@index([ownerUserId])
  @@map("mac_agent_devices")
}

// One unit of work for the Mac daemon: a shell command, or (M2) a CLI-session verb.
// `policyLevel` records the classifier's verdict at enqueue time and `approvedBy`
// records how an amber command earned its run — together they are the audit trail
// for every single thing the agent did on the owner's machine.
model MacAgentCommand {
  id       String         @id @default(uuid())
  deviceId String
  device   MacAgentDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// run_command | session_open | session_send | session_read | session_stop | screenshot | ping
  action   String
  params   Json?
  /// green | amber (red is never enqueued)
  policyLevel String      @default("green")
  /// null for green, else the AgentPendingAction id the owner approved.
  approvedBy  String?
  /// queued → delivered → done | failed | cancelled
  status      String      @default("queued")
  exitCode    Int?
  stdout      String?     @db.Text
  stderr      String?     @db.Text
  error       String?     @db.Text
  /// Free-form session/task correlation (M2 groups many commands under one session).
  sessionKey  String?
  /// How many times delivery was attempted. A poll response can be lost after the
  /// row is already marked delivered; the bus requeues those, and gives up loudly
  /// rather than redelivering forever.
  deliveryAttempts Int @default(0)
  createdAt   DateTime    @default(now())
  deliveredAt DateTime?
  resolvedAt  DateTime?

  @@index([deviceId, status])
  @@index([sessionKey])
  /// The live dock polls "what happened in the last 10 minutes" every 3s while
  /// work runs; without this it degrades into a scan as history grows.
  @@index([createdAt])
  @@map("mac_agent_commands")
}

// L4 — what a CLI session on the owner's Mac is actually SAYING. The daemon's
// session driver buffers per-session events (text / tool / turn_done…) with
// sequence numbers; it pushes them here so the live dock can show the session's
// own words, not just "a session exists". Text is capped at ingest; tool inputs
// and outputs never leave the Mac (same rule as session_read).
model MacAgentSessionEvent {
  id        String   @id @default(uuid())
  deviceId  String
  /// The daemon's own session id (not the CLI's).
  sessionId String
  /// claude | codex
  tool      String   @default("claude")
  /// The daemon's per-session monotonic sequence number — dedupe key on retry.
  seq       Int
  /// started | text | tool | sent | turn_done | error | ended
  kind      String
  /// Assistant text, turn result, sent text, or tool name — whichever the kind carries.
  text      String?  @db.Text
  isError   Boolean  @default(false)
  /// Per-turn cost, reported on turn_done.
  costUsd   Float?
  /// When the event happened on the Mac (daemon clock).
  at        DateTime
  createdAt DateTime @default(now())
  /// Push ledger: set once this event's owner notification was delivered (or
  /// deliberately skipped). Null + attempts<3 = still owed; later event POSTs
  /// sweep and retry, so a transient OneSignal failure loses nothing.
  pushedAt     DateTime?
  pushAttempts Int       @default(0)

  /// A daemon retry after a dropped POST must not duplicate the feed.
  @@unique([sessionId, seq])
  /// The live dock polls "last 10 minutes" every 3s while work runs.
  @@index([createdAt])
  @@map("mac_agent_session_events")
}

// L7 — live screen streaming: the daemon's ~1.5s capture loop upserts the
// newest frame here (ONE row per device, never a history — the dock only ever
// wants "now", and history would grow at a frame every second or two). The
// live-activity feed serves it through the same screenshot channel the docks
// already render, so streaming needed zero dock render changes.
model MacAgentFrame {
  deviceId  String   @id
  /// data:image/jpeg;base64,… downscaled daemon-side (Vercel body limit).
  dataUri   String   @db.Text
  /// Capture time on the Mac.
  at        DateTime
  updatedAt DateTime @updatedAt
  @@map("mac_agent_frames")
}

// Staff idle-detection pilot: one row per ongoing "off-task" episode (a category
// continuously observed across snapshots). Closed when the condition clears or
// goes stale. notifiedAt is set once the owner has been alerted for that episode.
model IdleEpisode {
  id          String    @id @default(uuid())
  category    String
  deviceId    String    @map("device_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  endedAt     DateTime? @map("ended_at")
  notifiedAt  DateTime? @map("notified_at")
  snapshotUrl String?   @map("snapshot_url") @db.Text
  note        String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([category, deviceId, endedAt])
  @@map("idle_episodes")
}

// Known-people registry for camera face identification. The owner registers
// himself + each staffer with 1–3 reference photos (stored in the agent-files
// bucket); the entrance/work-room watches pass those references to Gemini to
// name who is visible and to flag strangers. Photos are provided by the owner
// for his own office security — the vision prompt only matches against these.
model AgentKnownPerson {
  id         String   @id @default(uuid())
  businessId String   @default("ALMA_LIFESTYLE") @map("business_id")
  name       String
  /// owner | staff | family | other — label only, no behavior change
  role       String   @default("staff")
  /// JSON array of agent-files storage paths (reference photos)
  photoPaths Json     @default("[]") @map("photo_paths")
  active     Boolean  @default(true)
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([businessId, active])
  @@map("agent_known_people")
}

// Camera-speaker announcement queue. The owner (or the head agent) queues a
// Bangla announcement: text → Google TTS MP3 (agent-files bucket) → a job row
// here. The office-PC bridge polls /api/assistant/camera-bridge, claims the
// oldest queued job, downloads the signed MP3 and plays it through the chosen
// camera's speaker via go2rtc. Stale queued jobs expire (never play late).
model AgentCameraSpeakJob {
  id             String    @id @default(uuid())
  /// go2rtc stream name on the office PC: workroom | entrance | boss
  stream         String    @default("workroom")
  text           String    @db.Text
  /// agent-files storage path of the synthesized MP3
  audioPath      String    @map("audio_path")
  /// queued → delivered → done | failed
  status         String    @default("queued")
  error          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  deliveredAt    DateTime? @map("delivered_at")
  /// Unique claim identity. New bridges echo it in the ack; legacy bridges are
  /// accepted until camera_bridge_require_lease_token is enabled after upgrade.
  leaseToken     String?   @map("lease_token")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  attemptCount   Int       @default(0) @map("attempt_count")
  doneAt         DateTime? @map("done_at")
  /// Owner has been told the outcome (✅ বেজেছে / ⚠️ বাজেনি) — set by the sweep.
  notifiedAt     DateTime? @map("notified_at")

  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("agent_camera_speak_jobs")
}

