  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  versions        CreativeVoiceVersion[] @relation("CreativeVoiceVersions")
  audits          CreativeVoiceAudit[]

  @@unique([ownerId, name])
  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("creative_voices")
}

model CreativeVoiceVersion {
  id                String               @id @default(uuid())
  voiceId           String               @map("voice_id")
