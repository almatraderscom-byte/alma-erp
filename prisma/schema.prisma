/// Open-loop / pending-work tracker for the chat agent. When a turn ends with
/// something unfinished — an approval still waiting, or the owner's request not
/// fully done — a row here keeps it alive so a new task never erases the old one.
/// `resumeNote` is a SELF-CONTAINED instruction: the agent can resume the work
/// from that note alone, no system-prompt reload or tool-search needed.
model AgentOpenTask {
  id              String    @id @default(uuid())
  businessId      String    @default("ALMA_LIFESTYLE") @map("business_id")
  /// Chat this open task belongs to (so the inline chip is conversation-scoped).
  conversationId  String?   @map("conversation_id")
  title           String
  /// chat_followup = owner's request left unfinished · approval_pending = a
  /// confirm card still awaiting the owner's decision · checkpoint_failed /
  /// checkpoint_waiting = P0 terminal-state checkpoints (failure / needs-owner).
  kind            String    @default("chat_followup")
  /// open | running | done | cancelled
  status          String    @default("open")
  /// Self-contained Bangla brief the agent reads to pick the work back up.
  resumeNote      String    @map("resume_note") @db.Text
  /// P0 structured checkpoint (goal, doneSteps, currentStep, artifacts, error,
  /// resumeHint …) — resume never needs full chat history.
  checkpoint      Json?     @map("checkpoint")
  /// Links to the AgentPendingAction when kind = approval_pending.
  pendingActionId String?   @map("pending_action_id")
  /// Phase 4: the WorkflowRun this open task/checkpoint belongs to.
  workflowRunId   String?   @map("workflow_run_id")
  /// When the next "still pending?" nudge is due (30/60 min escalation).
  nudgeDueAt      DateTime? @map("nudge_due_at")
  nudgedCount     Int       @default(0) @map("nudged_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  completedAt     DateTime? @map("completed_at")

  @@index([conversationId, status])
  @@index([businessId, status, nudgeDueAt])
  @@map("agent_open_tasks")
}

model AgentToolEvent {
  id             String   @id @default(uuid())
  ts             DateTime @default(now())
  surface        String   @default("owner")
  toolName       String   @map("tool_name")
  success        Boolean
  verified       Boolean  @default(false)
  errorClass     String?  @map("error_class")
  latencyMs      Int      @default(0) @map("latency_ms")
  conversationId String?  @map("conversation_id")
  businessId     String   @default("ALMA_LIFESTYLE") @map("business_id")
  // ── Phase 1 span fields (roadmap: turn → route → tool-call → approval → proof).
  // All nullable/additive: legacy writers keep working; richer writers fill them.
  /// AgentTurn.id this event belongs to — joins a whole turn's trace together.
  turnId         String?  @map("turn_id")
  /// Span kind: 'route' (tool-pack selection), 'tool' (default), 'approval', 'proof'.
  phase          String   @default("tool")
  /// Stable machine error code (e.g. 'not_found', 'provider_4xx') — errorClass stays coarse.
  errorCode      String?  @map("error_code")
  /// Structured span payload: route → {groups, toolCount, modelId, headTier, versions};
  /// tool → {expectedTool?, argsValid?, idempotencyKey?}; proof → {kind, ref}.
  detail         Json?

  @@index([ts])
  @@index([toolName, ts])
  @@index([businessId, ts])
  @@index([turnId])
  @@map("agent_tool_events")
}

/// Phase 1 (roadmap): one-tap owner corrections on agent replies. Each row links
/// the owner's verdict to the exact conversation/turn/message (and through
/// AgentTurn.versions to the prompt/tool/router revision that produced it), so
/// "wrong tool" reports become trace-to-root-cause queries instead of chat lore.
model AgentOwnerFeedback {
  id             String   @id @default(uuid())
  ts             DateTime @default(now())
  /// wrong_tool | lost_progress | unnecessary_navigation | wrong_answer | too_many_questions | good
  kind           String
  conversationId String   @map("conversation_id")
  /// AgentTurn.id when the client knows it (links to the versions stamp + spans).
  turnId         String?  @map("turn_id")
  /// AgentMessage.id of the assistant reply the owner judged.
  messageId      String?  @map("message_id")
  /// Optional free-text note from the owner.
  note           String?
  businessId     String   @default("ALMA_LIFESTYLE") @map("business_id")

  @@index([ts])
  @@index([kind, ts])
  @@index([conversationId])
  @@map("agent_owner_feedback")
}

model AgentPlan {
  id               String          @id @default(uuid())
  conversationId   String?         @map("conversation_id")
  businessId       String          @default("ALMA_LIFESTYLE") @map("business_id")
  goal             String
  status           String          @default("draft")
  /// Phase 4: the WorkflowRun this plan belongs to.
  workflowRunId    String?         @map("workflow_run_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  completedAt      DateTime?       @map("completed_at")
  selfCheckNote    String?         @map("self_check_note")
  // Plan-Driver (autonomous pursue-until-completion). Phase A reads these only.
  doneCriteria     String?         @map("done_criteria")
  autodriveState   String          @default("idle") @map("autodrive_state")
  attemptCount     Int             @default(0) @map("attempt_count")
  maxAttempts      Int             @default(5) @map("max_attempts")
  nextTickAt       DateTime?       @map("next_tick_at")
  lastDrivenAt     DateTime?       @map("last_driven_at")
  costTaka         Int             @default(0) @map("cost_taka")
  /// S0 spend accounting: milli-taka so a sub-taka turn isn't rounded up to 1৳,
  /// plus a per-DAY bucket so the daily cap stops summing lifetime plan cost.
  costMilliTaka    Int             @default(0) @map("cost_milli_taka")
  costMilliTakaDay Int             @default(0) @map("cost_milli_taka_day")
  /// Asia/Dhaka calendar day (YYYY-MM-DD) the day-bucket above belongs to.
  costDay          String?         @map("cost_day")
  /// Build 103 Issue 3 — exact tracker linkage: the turn that created this
  /// plan and the settled assistant message that anchors its chat block.
  originTurnId     String?         @map("origin_turn_id")
  originAssistantMessageId String? @map("origin_assistant_message_id")
  /// Durable full work_steps_snapshot (last emitted revision) so cold history
  /// equals the settled live tracker exactly.
  trackerSnapshot  Json?           @map("tracker_snapshot")
  trackerRevision  Int             @default(0) @map("tracker_revision")
  steps            AgentPlanStep[]

  @@index([conversationId])
  @@index([businessId, status])
  @@index([autodriveState, nextTickAt], map: "agent_plans_autodrive_idx")
  @@index([costDay], map: "agent_plans_cost_day_idx")
  @@map("agent_plans")
}

model AgentPlanStep {
  id            String    @id @default(uuid())
  planId        String    @map("plan_id")
  plan          AgentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  seq           Int
  action        String
  toolName      String?   @map("tool_name")
  dependsOn     String[]  @map("depends_on")
  status        String    @default("pending")
  result        Json?
  error         String?
  startedAt     DateTime? @map("started_at")
  doneAt        DateTime? @map("done_at")
  /// S0 retry state — a failed step is re-queued (with backoff) until its own
  /// ceiling, instead of ending the whole plan on the first failure.
  attemptCount  Int       @default(0) @map("attempt_count")
  maxAttempts   Int       @default(3) @map("max_attempts")
  nextAttemptAt DateTime? @map("next_attempt_at")
  /// S0 queue mode — the worker turn this step is waiting on (reaped next tick).
  turnId        String?   @map("turn_id")
  dispatchedAt  DateTime? @map("dispatched_at")

  @@index([planId, seq])
  @@index([planId, status], map: "agent_plan_steps_plan_status_idx")
  @@map("agent_plan_steps")
}

// ─── OFFICE SECTION: Phase A (data foundation) ──────────────────────────────
// Centralized in-app office: per-task comment threads, task timeline, in-app
// notifications, Messenger-style group chat, weekly "Performer of the Week"
// award, and update-tracking columns on staff tasks. All additive; the task
// engine (status/proof/redo/approve) already exists on AgentStaffTask.

/// One message in a task's comment thread. Each task is its own thread —
/// owner, staff, and agent all post here (revision requests, replies, the
/// staff's submission note). Attachments are loose JSON (image URLs etc.).
model OfficeComment {
  id            String         @id @default(uuid())
  taskId        String         @map("task_id")
  task          AgentStaffTask @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)
  /// 'owner' | 'staff' | 'agent'
  authorType    String         @map("author_type")
  /// AgentStaff.id when authorType='staff' (loose ref, no FK).
  authorStaffId String?        @map("author_staff_id")
  /// User.id when authorType='owner' (loose ref to ERP user, no FK).
  authorUserId  String?        @map("author_user_id")
  /// 'comment' | 'revision_request' | 'submission'
  kind          String         @default("comment")
  body          String         @db.Text
  /// Loose JSON: [{ type:'image', url:'…' }, …]
  attachments   Json?
  seenByOwner   Boolean        @default(false) @map("seen_by_owner")
  seenByStaff   Boolean        @default(false) @map("seen_by_staff")
  businessId    String         @default("ALMA_LIFESTYLE") @map("business_id")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@index([businessId, createdAt(sort: Desc)])
  @@map("office_comments")
}

/// Append-only timeline of what happened to a task (created, dispatched,
/// submitted, approved, redo_requested, update_requested, reminded,
/// escalated, completed, self_initiated). Drives the per-task activity view.
model OfficeTaskEvent {
  id           String         @id @default(uuid())
  taskId       String         @map("task_id")
  task         AgentStaffTask @relation("TaskEvents", fields: [taskId], references: [id], onDelete: Cascade)
  kind         String
  summary      String
  /// 'owner' | 'staff' | 'agent' | 'system'
  actorType    String         @map("actor_type")
  actorStaffId String?        @map("actor_staff_id")
  meta         Json?
  businessId   String         @default("ALMA_LIFESTYLE") @map("business_id")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("office_task_events")
}

/// In-app notification bell items. Exactly one recipient is set: a User
/// (owner) or an AgentStaff. taskId is a loose ref (no FK) so notifications
/// can outlive their task. Telegram becomes notify-only on top of this.
model OfficeNotification {
  id               String    @id @default(uuid())
  /// User.id (owner) — loose ref, no FK.
  recipientUserId  String?   @map("recipient_user_id")
  /// AgentStaff.id — loose ref, no FK.
  recipientStaffId String?   @map("recipient_staff_id")
  taskId           String?   @map("task_id")
  /// 'task_assigned' | 'comment' | 'approved' | 'redo' | 'update_request' |
  /// 'reminder' | 'escalation' | 'award' | 'group_message'
  kind             String
  title            String
  body             String?   @db.Text
  read             Boolean   @default(false)
  readAt           DateTime? @map("read_at")
  businessId       String    @default("ALMA_LIFESTYLE") @map("business_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([recipientStaffId, read, createdAt(sort: Desc)])
  @@index([recipientUserId, read, createdAt(sort: Desc)])
  @@map("office_notifications")
}

/// Messenger-style office group chat (agent + all staff + owner). taskRef is
/// an optional loose pointer to the task being discussed. isAgentReply marks
/// the agent's owner-approved one-shot explanation.
model OfficeGroupMessage {
  id            String   @id @default(uuid())
  /// 'owner' | 'staff' | 'agent'
  authorType    String   @map("author_type")
  authorStaffId String?  @map("author_staff_id")
  authorUserId  String?  @map("author_user_id")
  body          String   @db.Text
  /// Optional AgentStaffTask.id this message is about (loose ref).
  taskRef       String?  @map("task_ref")
  attachments   Json?
  isAgentReply  Boolean  @default(false) @map("is_agent_reply")
  replyToId     String?  @map("reply_to_id")
  /// 'posted' (visible to all) | 'pending' (agent draft awaiting owner) | 'dismissed'
  status        String   @default("posted")
  businessId    String   @default("ALMA_LIFESTYLE") @map("business_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, status, createdAt(sort: Desc)])
  @@map("office_group_messages")
}

/// "Performer of the Week" award. One winner per business per week
/// (unique on businessId+weekStart). auto=true means the score picked it;
/// pinnedByOwner=true means the owner overrode the auto pick.
model OfficeWeeklyAward {
  id            String     @id @default(uuid())
  /// Monday (or week anchor) date for the awarded week.
  weekStart     DateTime   @map("week_start") @db.Date
  staffId       String     @map("staff_id")
  staff         AgentStaff @relation("StaffAwards", fields: [staffId], references: [id], onDelete: Cascade)
  score         Int        @default(0)
  auto          Boolean    @default(true)
  pinnedByOwner Boolean    @default(false) @map("pinned_by_owner")
  note          String?    @db.Text
  businessId    String     @default("ALMA_LIFESTYLE") @map("business_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@unique([businessId, weekStart])
  @@index([staffId])
  @@map("office_weekly_awards")
}

/// Penalty / reward the supervisor proposes for a staff member. The agent NEVER
/// writes payroll/ledger — it only raises a proposal here; the owner approves or
/// dismisses it from the office section. kind = 'penalty' | 'reward'.
model OfficeStaffProposal {
  id         String    @id @default(uuid())
  businessId String    @default("ALMA_LIFESTYLE") @map("business_id")
  /// AgentStaff.id — loose ref, no FK (proposals can outlive a staff row).
  staffId    String    @map("staff_id")
  /// AgentStaffTask.id that triggered this — loose ref, no FK.
  taskId     String?   @map("task_id")
  /// 'penalty' | 'reward'
  kind       String
  /// Suggested amount in whole taka (optional — owner sets the real figure).
  amount     Int?
  reason     String    @db.Text
  /// 'pending' | 'approved' | 'dismissed'
  status     String    @default("pending")
  /// User.id of the owner who decided — loose ref, no FK.
  decidedBy  String?   @map("decided_by")
  decidedAt  DateTime? @map("decided_at")
  meta       Json?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([businessId, status, createdAt])
  @@index([staffId, createdAt])
  @@map("office_staff_proposals")
}

/// Agent-placed outbound phone calls (ElevenLabs Conversational AI + Twilio).
/// One row per call: status while live, full transcript + summary after the
/// ElevenLabs post-call webhook fires. Keyed to ElevenLabs' conversation_id.
model AgentVoiceCall {
  id               String                   @id @default(uuid())
  elevenConvId     String?                  @unique @map("eleven_conversation_id")
  callSid          String?                  @map("call_sid")
  toNumber         String                   @map("to_number")
  recipientName    String?                  @map("recipient_name")
  purpose          String?
  firstMessage     String?                  @map("first_message")
  status           String                   @default("initiated")
  transcript       Json?
  summary          String?
  durationSecs     Int?                     @map("duration_secs")
  costCredits      Int?                     @map("cost_credits")
  conversationId   String?                  @map("conversation_id")
  /// Pending approval that dispatched this asynchronous call. Approval is not
  /// marked executed until the terminal report is durably stored.
  pendingActionId  String?                  @map("pending_action_id")
  provider         String?
  providerStatus   String?                  @map("provider_status")
  dialedAt         DateTime?                @map("dialed_at")
  answeredAt       DateTime?                @map("answered_at")
  reportReceivedAt DateTime?                @map("report_received_at")
  /// Listenable copy of the call (Supabase). Covers the post-transfer human conversation too.
  recordingUrl     String?                  @map("recording_url")
  recordingSecs    Int?                     @map("recording_secs")
  /// 'inbound' | 'outbound'. The SIP gateway has always sent this on the CDR; until the
  /// phone console there was nowhere to put it, so direction had to be guessed from
  /// `purpose`. Guessing is wrong for one-way message calls, hence a real column.
  direction        String?
  /// Caller's number on an inbound call, and the DID they dialled. `toNumber` holds the
  /// far end either way, so these two are what make an inbound row readable.
  fromNumber       String?                  @map("from_number")
  did              String?
  /// ISDN hangup cause as the switch reported it (16 = normal, 17 = busy, 19 = no answer,
  /// 34 = no circuit …). "Why did this call fail" is unanswerable without it.
  hangupCause      Int?                     @map("hangup_cause")
  hangupCauseTxt   String?                  @map("hangup_cause_txt")
  /// Where a transferred call went and how long the two humans then spoke — the AI steps
  /// off the audio path at transfer, so this is the only record of that half.
  transferredTo    String?                  @map("transferred_to")
  transferTalkSecs Int?                     @map("transfer_talk_secs")
  /// Objective audio-quality counters from the gateway's playout, per call. An underrun is
  /// the queue running dry mid-sentence (~200 ms of dead air inside a word); `dropped` is
  /// the opposite — frames skipped to catch up. Previously these existed only in one log
  /// line on the VPS, so an audio regression could only be caught by the owner's ear.
  audioUnderruns   Int?                     @map("audio_underruns")
  audioDropped     Int?                     @map("audio_dropped")
  audioCushionFrames Int?                   @map("audio_cushion_frames")
  audioFramesOut   Int?                     @map("audio_frames_out")
  audioSilenceFrames Int?                   @map("audio_silence_frames")
  audioBargeIns    Int?                     @map("audio_barge_ins")
  /// Turn boundaries — the model finishing a sentence. Counted separately from underruns
  /// because treating one as the other is what made the jitter cushion ratchet up all call.
  audioTurnEnds    Int?                     @map("audio_turn_ends")
  /// What the NETWORK did, sampled from Asterisk's own RTP counters while the call was up.
  /// A call's recording is tapped inside Asterisk, so it can never contain packet loss that
  /// happened afterwards on the wire — which is why a recording can sound clean while the
  /// call did not. These are the numbers that close that blind spot.
  rtpCodec         String?                  @map("rtp_codec")
  rtpRxLost        Int?                     @map("rtp_rx_lost")
  rtpRxLostPct     Float?                   @map("rtp_rx_lost_pct")
  rtpRxJitterMs    Float?                   @map("rtp_rx_jitter_ms")
  rtpTxLost        Int?                     @map("rtp_tx_lost")
  rtpTxLostPct     Float?                   @map("rtp_tx_lost_pct")
  rtpTxJitterMs    Float?                   @map("rtp_tx_jitter_ms")
  rtpRttMs         Float?                   @map("rtp_rtt_ms")
  createdAt        DateTime                 @default(now()) @map("created_at")
  endedAt          DateTime?                @map("ended_at")
  deliveries       AgentVoiceCallDelivery[]

  @@index([status, createdAt])
  @@index([conversationId])
  @@index([pendingActionId])
  @@index([createdAt])
  @@map("agent_voice_calls")
}

/// Durable per-channel delivery outbox for a terminal phone-call result. A call
/// report is stored first, then Telegram/chat/agent-continuation are leased and
/// retried independently; one broken channel can never suppress another.
model AgentVoiceCallDelivery {
  id          String         @id @default(uuid())
  callId      String         @map("call_id")
  call        AgentVoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  /// telegram | push | continuation
  channel     String
  /// pending | processing | retry | delivered | dead
  status      String         @default("pending")
  attempts    Int            @default(0)
  availableAt DateTime       @default(now()) @map("available_at")
  leaseUntil  DateTime?      @map("lease_until")
  lastError   String?        @map("last_error") @db.Text
  deliveredAt DateTime?      @map("delivered_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")

  @@unique([callId, channel])
  @@index([status, availableAt])
  @@map("agent_voice_call_deliveries")
}

/// Scheduled two-way calls — the agent queues a call for a future time (owner-approved
/// at schedule time); the /api/cron/scheduled-calls cron fires each due row via
/// placeOutboundCall. status: scheduled | placed | failed | cancelled.
model ScheduledCall {
  id             String    @id @default(uuid())
  toNumber       String    @map("to_number")
  recipientName  String?   @map("recipient_name")
  purpose        String
  firstMessage   String?   @map("first_message")
  callType       String    @default("contact") @map("call_type")
  voiceGender    String    @default("female") @map("voice_gender")
  dueAt          DateTime  @map("due_at")
  status         String    @default("scheduled")
  /// null = one-off; 'daily' | 'weekdays' | 'weekly' — the cron re-books the next
  /// occurrence after firing (human-PA point 4: recurring report calls).
  recurrence     String?
  placedCallId   String?   @map("placed_call_id")
  error          String?
  conversationId String?   @map("conversation_id")
  businessId     String    @default("ALMA_LIFESTYLE") @map("business_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  placedAt       DateTime? @map("placed_at")

  @@index([status, dueAt])
  @@map("scheduled_calls")
}

/// PA-2 proactive-call escalation ladder — when something urgent needs the owner
/// (stuck approval, stuck staff task, tier-3 business alert), the agent CALLS him:
/// WhatsApp live call first, then (unanswered after the stage wait) a direct PSTN
/// call, then a summary push. Driven by /api/cron/call-escalations every minute.
/// status: queued | awaiting_approval | wa_calling | pstn_calling | answered |
///         unreached | cancelled | failed
model AgentCallEscalation {
  id               String    @id @default(uuid())
  /// approval_stuck | staff_task_stuck | business_alert | manual
  trigger          String
  /// Dedupe key for the underlying cause (e.g. approval:<id>) — one ACTIVE
  /// escalation per refId at a time.
  refId            String    @map("ref_id")
  title            String
  purpose          String    @db.Text
  status           String    @default("queued")
  /// 'proactive_call' approval card that gates this row while autonomy is OFF.
  approvalActionId String?   @map("approval_action_id")
  waCallId         String?   @map("wa_call_id")
  pstnCallId       String?   @map("pstn_call_id")
  /// Stage-0 in-app VoIP ring (agent_app_calls.id) — tried before WhatsApp/PSTN.
  appCallId        String?   @map("app_call_id")
  /// First dial of the ladder — drives the Dhaka-day proactive-call cap.
  firstCallAt      DateTime? @map("first_call_at")
  /// When the cron should look at this row again (stage timeout / quiet-hours defer).
  nextCheckAt      DateTime? @map("next_check_at")
  note             String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  resolvedAt       DateTime? @map("resolved_at")

  @@index([status, nextCheckAt])
  @@index([refId, status])
  @@index([firstCallAt])
  @@map("agent_call_escalations")
}

/// Agent → owner IN-APP two-way call (WhatsApp-style VoIP ring into the ALMA app,
/// answered into a Gemini Live session). Works abroad where the BD number and
/// WhatsApp calls do not. Rung by the PA-2 ladder (stage 0) and the salah
/// scheduler when the owner-abroad toggle is on.
model AgentAppCall {
  id         String    @id @default(uuid())
  /// Why the agent is calling — Bangla; injected into the live session brief.
  purpose    String    @db.Text
  /// 'ladder' | 'salah' | 'manual'
  source     String    @default("ladder")
  /// ringing | answered | completed | declined | unanswered | failed
  status     String    @default("ringing")
  /// Push delivery snapshot ({voip, fcm, delivered}) for diagnostics.
  pushResult Json?     @map("push_result")
  /// Active call-capable installations eligible when this distributed ring was
  /// created. Lifecycle ownership is checked against this immutable snapshot,
  /// not a registry row that can rotate while the call is in flight.
  eligibleDeviceIds String[] @default([]) @map("eligible_device_ids")
  /// SHA-256 of the per-ring bearer receipt delivered inside the VoIP payload.
  /// It lets an upgraded app reached through a legacy token prove receipt while
  /// its encrypted installation registration is still racing.
  claimReceiptHash String? @map("claim_receipt_hash") @db.Char(64)
  answeredAt DateTime? @map("answered_at")
  /// Stable native installation that won the ringing -> answered CAS. Only
  /// this device may close an answered call; server recovery is explicit.
  answeringDeviceId String? @map("answering_device_id") @db.VarChar(180)
  endedAt    DateTime? @map("ended_at")
  summary    String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("agent_app_calls")
}

/// ─── GROWTH AUTOPILOT: scheduled content calendar ────────────────────────────
/// One row per planned social post. The agent drafts entries (status 'draft');
/// the owner approves them into 'approved'; the growth-publish cron picks up
/// 'approved' entries whose scheduledFor is due, publishes to FB/IG, verifies,
/// then marks 'published' (or 'failed'). Nothing publishes without owner approval.
model AgentContentCalendar {
  id             String    @id @default(uuid())
  businessId     String    @default("ALMA_LIFESTYLE") @map("business_id")
  /// 'facebook' | 'instagram'
  platform       String
  /// Page selector understood by resolvePageId ('lifestyle' | 'trading' | a page id).
  pageRef        String    @default("lifestyle") @map("page_ref")
  caption        String    @db.Text
  /// Supabase storage path for the image (e.g. 'generated/...'). Null = text-only (FB).
  imageRef       String?   @map("image_ref")
  scheduledFor   DateTime  @map("scheduled_for")
  /// 'draft' | 'approved' | 'published' | 'failed' | 'canceled'
  status         String    @default("draft")
  postId         String?   @map("post_id")
  permalinkUrl   String?   @map("permalink_url")
  error          String?   @db.Text
  conversationId String?   @map("conversation_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  approvedAt     DateTime? @map("approved_at")
  publishedAt    DateTime? @map("published_at")

  @@index([status, scheduledFor])
  @@index([businessId, status])
  @@index([conversationId])
  @@map("agent_content_calendar")
}

/// Growth Autopilot — weekly analytics snapshot. One row per digest run so
/// week-over-week history builds up over time (ads spend/ROAS, content
/// cadence, catalog health). Written by the growth-digest cron.
model AgentGrowthMetric {
  id          String   @id @default(uuid())
  businessId  String   @default("ALMA_LIFESTYLE") @map("business_id")
  /// 'weekly_digest' — snapshot source/kind.
  source      String   @default("weekly_digest")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  /// Aggregated metrics blob (ads totals, content counts, catalog stats).
  metrics     Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([businessId, periodStart])
  @@index([source, periodStart])
  @@map("agent_growth_metric")
}

/// Growth Autopilot — a keyword the owner wants tracked in Google (Bangladesh).
/// The weekly rank-tracker cron pulls SERP for every active row (cost-capped).
model AgentTrackedKeyword {
  id          String   @id @default(uuid())
  businessId  String   @default("ALMA_LIFESTYLE") @map("business_id")
  keyword     String
  /// Optional product this keyword should ideally rank for (almatraders.com/products/{slug}).
  productSlug String?  @map("product_slug")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([businessId, keyword])
  @@index([active])
  @@map("agent_tracked_keyword")
}

/// Growth Autopilot — one SERP observation for a tracked keyword. History of
/// where almatraders.com ranked over time, written by the rank-tracker cron.
model AgentKeywordRank {
  id           String   @id @default(uuid())
  businessId   String   @default("ALMA_LIFESTYLE") @map("business_id")
  keyword      String
  productSlug  String?  @map("product_slug")
  /// Best position of an almatraders.com URL in the top results, null = not in top N.
  rank         Int?
  url          String?
  foundInTop10 Boolean  @default(false) @map("found_in_top10")
  /// Snapshot of the top results for context (rank/url/title).
  top10        Json?
  checkedAt    DateTime @default(now()) @map("checked_at")

  @@index([keyword, checkedAt])
  @@index([businessId, checkedAt])
  @@map("agent_keyword_rank")
}

/// Office Live Intercom — a walkie-talkie voice broadcast from the owner to
/// staff phones inside the office group chat. Staff receipts track the
/// delivered → played → confirmed lifecycle per person.
model OfficeIntercomBroadcast {
  id            String                  @id @default(uuid())
  businessId    String                  @default("ALMA_LIFESTYLE") @map("business_id")
  /// Owner User.id who sent it (owner-only in v1).
  senderUserId  String?                 @map("sender_user_id")
  /// 'voice' (PTT audio) | 'urgent' (full-volume text alert, no audio).
  kind          String                  @default("voice")
  /// Storage object path in the agent-files bucket (null for 'urgent').
  audioPath     String?                 @map("audio_path")
  /// Long-lived signed URL staff phones stream from.
  audioUrl      String?                 @map("audio_url") @db.Text
  /// Negotiated recorder mimeType (audio/mp4 on iOS, audio/webm on desktop Chrome).
  mediaType     String?                 @map("media_type")
  durationSec   Int                     @default(0) @map("duration_sec")
  /// Agent auto-transcript (Bangla STT), filled asynchronously after send.
  transcript    String?                 @db.Text
  /// AgentStaff.id when the broadcast targets one person; null = everyone.
  targetStaffId String?                 @map("target_staff_id")
  /// For kind='call': the single callee's User.id (works for staff→owner too,
  /// where the target is the owner and has no AgentStaff row). null for voice/urgent.
  targetUserId  String?                 @map("target_user_id")
  /// Display name of who placed the call ("বস — মারুফ" or a staff's name) — the
  /// callee's ring/CallKit label. null for non-call kinds.
  callerName    String?                 @map("caller_name")
  /// Set when a call is over: caller cancelled, callee declined, timed out (missed),
  /// or completed. Non-null = "stop ringing / call finished" for every client.
  endedAt       DateTime?               @map("ended_at")
  /// Why the call ended: 'cancelled' | 'declined' | 'missed' | 'completed'.
  endedReason   String?                 @map("ended_reason")
  createdAt     DateTime                @default(now()) @map("created_at")
  receipts      OfficeIntercomReceipt[]

  @@index([businessId, createdAt(sort: Desc)])
  @@map("office_intercom_broadcasts")
}

/// Append-only, non-secret event ledger for tracing one office call across the
/// server, wake-push providers, web, iOS, Android, and Agora. It deliberately
/// has no foreign key so diagnostics survive a future call-session migration or
/// cleanup of the legacy intercom row.
model OfficeCallEvent {
  id          String   @id @default(uuid())
  callId      String   @map("call_id")
  businessId  String   @map("business_id")
  actorUserId String?  @map("actor_user_id")
  deviceId    String?  @map("device_id")
  source      String
  platform    String?
  appBuild    String?  @map("app_build")
  buildSha    String?  @map("build_sha")
  event       String
  state       String?
  provider    String?
  success     Boolean?
  latencyMs   Int?     @map("latency_ms")
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([callId, occurredAt(sort: Asc)])
  @@index([businessId, occurredAt(sort: Desc)])
  @@index([event, occurredAt(sort: Desc)])
  @@map("office_call_events")
}

enum OfficeCallState {
  CREATED
  RINGING
  ANSWERED
  CONNECTING
  CONNECTED
  RECONNECTING
  ENDED
}

enum OfficeCallTerminalReason {
  DECLINED
  CANCELLED
  MISSED
  COMPLETED
  FAILED
  BUSY
  PUSH_UNREACHABLE
}

enum OfficeCallLegRole {
  CALLER
  CALLEE
}

enum OfficeCallOutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD
}

/// Canonical server-owned truth for one 1:1 Office voice call. Legacy intercom
/// rows remain a compatibility/history projection while this domain rolls out.
model OfficeCallSession {
  id                String                      @id @default(uuid())
  businessId        String                      @map("business_id")
  callerUserId      String                      @map("caller_user_id")
  calleeUserId      String                      @map("callee_user_id")
  targetStaffId     String?                     @map("target_staff_id")
  legacyBroadcastId String?                     @unique @map("legacy_broadcast_id")
  clientRequestId   String?                     @map("client_request_id")
  agoraChannel      String                      @unique @map("agora_channel")
  state             OfficeCallState             @default(CREATED)
  terminalReason    OfficeCallTerminalReason?   @map("terminal_reason")
  version           Int                         @default(0)
  ringExpiresAt     DateTime                    @map("ring_expires_at")
  maxEndsAt         DateTime                    @map("max_ends_at")
  answeredAt        DateTime?                   @map("answered_at")
  connectedAt       DateTime?                   @map("connected_at")
  endedAt           DateTime?                   @map("ended_at")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  legs              OfficeCallLeg[]
  outbox            OfficeCallOutbox[]
  participantLocks  OfficeCallParticipantLock[]

  @@unique([businessId, callerUserId, clientRequestId])
  @@index([businessId, state, createdAt(sort: Desc)])
  @@index([callerUserId, state])
  @@index([calleeUserId, state])
  @@map("office_call_sessions")
}

/// One logical media leg per participant. Phase 3/4 may add device-specific legs;
/// stable per-user Agora UIDs are allocated at call creation and never use uid=0.
model OfficeCallLeg {
  id                String            @id @default(uuid())
  callId            String            @map("call_id")
  participantUserId String            @map("participant_user_id")
  role              OfficeCallLegRole
  state             OfficeCallState   @default(CREATED)
  agoraUid          Int               @map("agora_uid")
  deviceId          String?           @map("device_id")
  joinedAt          DateTime?         @map("joined_at")
  leftAt            DateTime?         @map("left_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  call              OfficeCallSession @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, participantUserId])
  @@unique([callId, agoraUid])
  @@index([participantUserId, createdAt(sort: Desc)])
  @@map("office_call_legs")
}

/// Transactional one-active-call lock. Creating both participant rows in the
/// call transaction makes concurrent create attempts fail deterministically.
model OfficeCallParticipantLock {
  userId     String            @id @map("user_id")
  callId     String            @map("call_id")
  businessId String            @map("business_id")
  createdAt  DateTime          @default(now()) @map("created_at")
  call       OfficeCallSession @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([businessId])
  @@map("office_call_participant_locks")
}

/// Durable delivery work created in the same transaction as the call. Phase 2
/// owns provider processing/retry; Phase 1 only guarantees atomic persistence.
model OfficeCallOutbox {
  id             String                 @id @default(uuid())
  callId         String                 @map("call_id")
  targetUserId   String                 @map("target_user_id")
  kind           String
  idempotencyKey String                 @unique @map("idempotency_key")
  payload        Json
  status         OfficeCallOutboxStatus @default(PENDING)
  attempts       Int                    @default(0)
  availableAt    DateTime               @default(now()) @map("available_at")
  lockedAt       DateTime?              @map("locked_at")
  processedAt    DateTime?              @map("processed_at")
  lastErrorCode  String?                @map("last_error_code")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  call           OfficeCallSession      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([callId, createdAt])
  @@map("office_call_outbox")
}

/// Explicit call-device registry. Raw provider tokens are never returned by
/// diagnostics; Phase 2 will own authenticated registration and encryption.
model OfficeCallDevice {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  businessId        String    @map("business_id")
  installationId    String?   @map("installation_id")
  platform          String
  environment       String
  provider          String
  providerTokenHash String    @unique @map("provider_token_hash")
  providerTokenEnc  String?   @map("provider_token_enc") @db.Text
  appBuild          String?   @map("app_build")
  buildSha          String?   @map("build_sha")
  active            Boolean   @default(true)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  invalidatedAt     DateTime? @map("invalidated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([userId, installationId, provider])
  @@index([userId, active, lastSeenAt(sort: Desc)])
  @@index([businessId, platform, environment, active])
  @@map("office_call_devices")
}

/// Per-staff receipt for one intercom broadcast.
model OfficeIntercomReceipt {
  id          String                  @id @default(uuid())
  broadcastId String                  @map("broadcast_id")
  staffId     String                  @map("staff_id")
  /// Staff device fetched the broadcast (set server-side on their first feed poll).
  deliveredAt DateTime?               @map("delivered_at")
  /// Audio actually started playing on the staff phone.
  playedAt    DateTime?               @map("played_at")
  /// Staff tapped "শুনেছি — কনফার্ম".
  confirmedAt DateTime?               @map("confirmed_at")
  broadcast   OfficeIntercomBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, staffId])
  @@index([staffId, confirmedAt])
  @@map("office_intercom_receipts")
}

/// ── Owner personal receivable/payable khata (পাওনা-দেনা) ─────────────────
/// Persons/organisations OUTSIDE the staff system (owner decision 2026-07-13).
/// Serial transactions per party; running balance is computed, never stored.
/// Entries are owner-editable (+/- adjust): edits append the prior values to
/// edit_history, deletes are soft (deleted_at) — the paper trail survives.
enum PersonalLedgerDirection {
  OUT // owner gave money (টাকা দিলাম) → they owe more
  IN // owner received/borrowed money (টাকা নিলাম) → they owe less
}

model PersonalLedgerParty {
  id          String              @id @default(uuid())
  /// User.id of the owner this khata belongs to (super admin only today).
  ownerUserId String              @map("owner_user_id")
  name        String
  phone       String?
  note        String?             @db.Text
  archivedAt  DateTime?           @map("archived_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  txns        PersonalLedgerTxn[]

  @@index([ownerUserId, archivedAt])
  @@map("personal_ledger_parties")
}

model PersonalLedgerTxn {
  id          String                  @id @default(uuid())
  partyId     String                  @map("party_id")
  direction   PersonalLedgerDirection
  amount      Decimal                 @db.Decimal(12, 2)
  reason      String
  /// Calendar day of the transaction (Asia/Dhaka date, stored at midnight UTC).
  txnDate     DateTime                @map("txn_date")
  deletedAt   DateTime?               @map("deleted_at")
  /// Append-only audit: [{at, byUserId, prev:{direction,amount,reason,txnDate}}]
  editHistory Json?                   @map("edit_history")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  party       PersonalLedgerParty     @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, deletedAt, txnDate])
  @@map("personal_ledger_txns")
}

/// ── Roadmap 1 Phase 32 — Conversation Focus spine ────────────────────────────
/// One durable answer to "where are we and what happens next" per conversation.
/// A focus POINTS at work (WorkflowRun / checkpoint taskRef / open task) and
/// carries the continuation contract: original goal, current step, verified
/// completed steps, last successful effect, blocker, exact next actions and
/// completion criteria. A small stack: at most one `active` focus per
/// conversation plus `parked` and `awaiting_owner` entries — never "latest row
/// wins". Additive only; chat text and summaries never replace it.
model AgentConversationFocus {
  id                 String    @id @default(uuid())
  conversationId     String    @map("conversation_id")
  businessId         String    @default("ALMA_LIFESTYLE") @map("business_id")
  /// active | parked | awaiting_owner | done | abandoned
  status             String    @default("active")
  priority           Int       @default(0)
  /// The owner's original ask, verbatim-ish (Bangla ok).
  goal               String    @db.Text
  /// Job family (matches WorkflowRun.kind / state-router packs where possible).
  kind               String    @default("generic")
  /// Canonical work pointer(s) — any may be null for untemplated work.
  workflowRunId      String?   @map("workflow_run_id")
  checkpointTaskRef  String?   @map("checkpoint_task_ref")
  openTaskId         String?   @map("open_task_id")
  pendingActionId    String?   @map("pending_action_id")
  askCardId          String?   @map("ask_card_id")
  /// Current step label + verified completed steps/effects (never re-run).
  currentStep        String?   @map("current_step")
  completedSteps     Json?     @map("completed_steps")
  lastEffectId       String?   @map("last_effect_id")
  /// Failure/blocker state: error class + who unblocks (owner|system|external).
  lastErrorClass     String?   @map("last_error_class")
  blocker            String?
  /// Exact legal next actions (tool names / step labels) + done-when criteria.
  nextActions        Json?     @map("next_actions")
  completionCriteria String?   @map("completion_criteria") @db.Text
  artifacts          Json?
  /// Surface the focus was last touched from: web | native | telegram.
  surface            String?
  /// Optimistic concurrency — writers must present the version they read.
  version            Int       @default(1)
  leaseUntil         DateTime? @map("lease_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  completedAt        DateTime? @map("completed_at")

  @@index([conversationId, status, updatedAt])
  @@index([workflowRunId])
  @@map("agent_conversation_focuses")
}

/// Append-only event log for every focus state change (audit + replay).
model AgentFocusEvent {
  id             String   @id @default(uuid())
  focusId        String   @map("focus_id")
  conversationId String   @map("conversation_id")
  /// created | updated | parked | resumed | awaiting_owner | blocked | completed | abandoned
  type           String
  fromStatus     String?  @map("from_status")
  toStatus       String?  @map("to_status")
  version        Int
  /// turn | approval | worker | reconcile | resolver
  cause          String   @default("turn")
  detail         Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([focusId, createdAt])
  @@index([conversationId, createdAt])
  @@map("agent_focus_events")
}

// ─── GRIND ENGINE: durable findings store (S1) ───────────────────────────────
// One campaign ("fix all 246 issues the audit found") is one AgentFindingSet;
// every individual problem is one AgentFinding. The fingerprint is byte-identical
// to the key the before/after client report already uses (`${scope}|${code}`), so
// the store and that report agree by construction.

/// A fix campaign over one measured surface (a site audit, a health scan, the
/// product-SEO sweep). Completion is decided by ARITHMETIC over its findings —
/// see grind/completion.ts — never by a model saying it is done.
model AgentFindingSet {
  id              String         @id @default(uuid())
  businessId      String         @default("ALMA_LIFESTYLE") @map("business_id")
  /// Which adapter produced (and can re-measure) these findings.
  /// 'seo_audit' | 'health_scan' | 'product_seo'
  source          String
  /// What was measured — a site origin, a scan scope, a catalogue id.
  target          String
  label           String?
  /// open | complete | halted
  status          String         @default("open")
  planId          String?        @map("plan_id")
  conversationId  String?        @map("conversation_id")
  /// Storage path of the baseline snapshot the campaign is measured against.
  baselineRef     String?        @map("baseline_ref")
  haltReason      String?        @map("halt_reason")
  /// How many times a fix batch introduced NEW problems. Three halts the campaign.
  regressionCount Int            @default(0) @map("regression_count")
  lastMeasuredAt  DateTime?      @map("last_measured_at")
  lastFixAt       DateTime?      @map("last_fix_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  findings        AgentFinding[]

  @@index([status], map: "agent_finding_sets_status_idx")
  @@index([planId], map: "agent_finding_sets_plan_idx")
  @@map("agent_finding_sets")
}

/// One problem inside a campaign.
///
/// `status` is the safety model: only the deterministic step-verifier may write
/// 'fixed'. A model's verdict can reach at most 'fix_claimed', which the
/// end-of-campaign re-measurement has to confirm.
model AgentFinding {
  id           String          @id @default(uuid())
  setId        String          @map("set_id")
  set          AgentFindingSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  /// `${scope}|${code}` — identical to seo-report.ts's compare key.
  fingerprint  String
  scope        String
  code         String
  /// Fix family — findings that share a root cause and one fix approach.
  family       String
  severity     String
  detail       String?
  /// open | in_progress | fix_claimed | fixed | regressed | needs_rediagnosis | wont_fix
  status       String          @default("open")
  rootCause    String?         @map("root_cause")
  /// Concrete evidence for the root cause: file:line or a URL.
  rootCauseRef String?         @map("root_cause_ref")
  batchKey     String?         @map("batch_key")
  stepId       String?         @map("step_id")
  note         String?
  /// True when this finding did NOT exist in the baseline — a regression we caused.
  introduced   Boolean         @default(false)
  firstSeenAt  DateTime        @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime?       @map("last_seen_at")
  reMeasuredAt DateTime?       @map("re_measured_at")
  fixedAt      DateTime?       @map("fixed_at")

  @@unique([setId, fingerprint], map: "agent_findings_set_fingerprint_key")
  @@index([setId, status], map: "agent_findings_set_status_idx")
  @@index([setId, family], map: "agent_findings_set_family_idx")
  @@map("agent_findings")
}
