// ─── AGENT MODULE (Phase 0+) ────────────────────────────────────────────────
// These tables are owned exclusively by the agent module (src/agent/).
// ERP code must never import from src/agent/ or query these tables directly.

/// Top-level workspace for grouping agent conversations (e.g. ALMA Lifestyle, Trading, Personal).
model AgentProject {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  systemInstructions String?             @db.Text
  /// Business scope of this project. null = personal / cross-business.
  /// One of: 'ALMA_LIFESTYLE' | 'ALMA_TRADING' | null
  businessId         String?             @map("business_id")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  conversations      AgentConversation[]

  @@index([businessId])
  @@map("agent_projects")
}

/// A single conversation thread, optionally scoped to a project.
model AgentConversation {
  id                 String          @id @default(uuid())
  projectId          String?
  project            AgentProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title              String?
  modelId            String          @default("claude-sonnet-4-6") @map("model")
  /// How the agent may work in this chat: auto | direct | plan | plan_drive.
  /// NULL = auto. Enforced by withholding tools, not by prompt text.
  chatMode           String?         @map("chat_mode")
  /// PM-1: how MUCH the agent may do without Boss in this chat:
  /// plan | careful | standard | supervised | elevated. NULL = standard.
  /// The tier ceiling still applies above it — R4 is owner-only in every mode.
  permissionMode     String?         @map("permission_mode")
  /// The time-boxed elevation grant 'elevated' runs under:
  /// { families: string[], expiresAt: ISO }. No expiry ⇒ treated as absent.
  elevationGrant     Json?           @map("elevation_grant")
  /// The size of the job running in this chat: chat | deep | long_run. Kept for
  /// the job's lifetime so a two-word answer does not shrink it back to a chat
  /// reply mid-work. Expires — a class must never leak into next week.
  workClass          String?         @map("work_class")
  workClassUntil     DateTime?       @map("work_class_until")
  source             String          @default("web")
  archived           Boolean         @default(false)
  pinned             Boolean         @default(false)
  summarizedAt       DateTime?       @map("summarized_at")
  lastMessageAt      DateTime?       @map("last_message_at")
  totalCostUsd       Float           @default(0) @map("total_cost_usd")
  contextSummary     String?         @map("context_summary")
  compactedToId      String?         @map("compacted_to_id")
  // B3 tail compaction: the oldest turns are folded into `tailSummary` (which
  // rides the STABLE/cached system block) while recent turns stay verbatim.
  // `tailCompactedCount` is the watermark — how many of the oldest messages the
  // summary already represents — so folding happens in stable batches (one
  // cache-write per fold, byte-stable in between).
  tailSummary        String?         @map("tail_summary")
  tailCompactedCount Int             @default(0) @map("tail_compacted_count")
  /// Business scope inherited from project. null = personal / cross-business.
  /// One of: 'ALMA_LIFESTYLE' | 'ALMA_TRADING' | null
  businessId         String?         @map("business_id")
  /// SK-3: the skill pinned for this chat. One chat, one job — re-picking a 5k
  /// token skill every turn would destroy the prompt cache. NULL = none pinned.
  pinnedSkill        String?         @map("pinned_skill")
  /// SK-3/U5: WHY that skill was pinned — layer, reason, candidates. Stored so a
  /// wrong pin has an answer instead of a guess.
  skillRouteTrace    Json?           @map("skill_route_trace")
  /// P0-1 (foundation audit): the head model this JOB runs on. Routing used to be
  /// decided per message, so one task could start on Luna and finish on DeepSeek.
  /// The pin holds for the job; it may only ever escalate (light → heavy), never
  /// downgrade, and it expires so it cannot leak into tomorrow's chat.
  pinnedHeadModel    String?         @map("pinned_head_model")
  /// HeadTier the pin was taken at: light | marketing | heavy | explicit.
  pinnedHeadTier     String?         @map("pinned_head_tier")
  /// WHY the pin exists — the HeadDecision.via that created it (decision log).
  pinnedHeadVia      String?         @map("pinned_head_via")
  pinnedHeadUntil    DateTime?       @map("pinned_head_until")
  /// P0-4 (foundation audit): Boss's own corrections in this chat, newest first
  /// — [{ text, at }]. They used to live only in the transcript, so a later turn
  /// (or a different model) had to notice them among fifty other lines. Stored
  /// so the newest can ride at the TOP of every following turn's context.
  corrections        Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  messages           AgentMessage[]
  artifacts          AgentArtifact[]

  @@index([projectId])
  @@index([source])
  @@index([businessId])
  @@index([updatedAt(sort: Desc)])
  @@map("agent_conversations")
}

/// Individual turn in a conversation. content stores full Anthropic content blocks.
model AgentMessage {
  id              String                       @id @default(uuid())
  conversationId  String
  /// Stable browser-send id. Direct Vercel and VPS fallback paths share it so
  /// one logical owner send can create at most one persisted user message.
  clientRequestId String?                      @unique @map("client_request_id")
  conversation    AgentConversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String
  content         Json
  tokensIn        Int?
  tokensOut       Int?
  costUsd         Decimal?                     @db.Decimal(10, 6)
  usage           Json?
  // B2: per-message embedding for semantic recall of OLD turns that have aged
  // out of the verbatim history window. Populated best-effort/async after the
  // row is written; `summary` is reserved for a future condensed form (B3).
  embedding       Unsupported("vector(1536)")?
  summary         String?                      @db.Text
  createdAt       DateTime                     @default(now())
  artifacts       AgentArtifact[]
  toolCalls       AgentToolCall[]

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

/// One server-side turn execution. Created when a turn starts and updated to a
/// terminal status when it finishes. This is what lets a turn survive the iPhone
/// app being backgrounded/closed: the turn keeps running server-side and the
/// client re-syncs by polling this row's status on re-open. `cancelRequested` is
/// the cross-instance Stop signal — a cancel POST hits a different serverless
/// instance than the running turn, so an in-memory AbortController can't reach it;
/// the running loop polls this flag each iteration instead.
/// Phase 4 (roadmap AGENT-STATE-001) — the ONE canonical record of an in-flight
/// job: what outcome is being pursued, what state it is in, and what is legal
/// next. Plans, open tasks, checkpoints and pending actions LINK here; chat
/// history is supporting context, not task state.
model WorkflowRun {
  id               String    @id @default(uuid())
  conversationId   String?   @map("conversation_id")
  businessId       String    @default("ALMA_LIFESTYLE") @map("business_id")
  /// Job family: browser | plan | creative | social | staff_dispatch | seo |
  /// calls | workbench | generic … (matches state-router pack keys where possible)
  kind             String
  goal             String    @db.Text
  /// active | waiting_owner | waiting_worker | done | failed | cancelled
  status           String    @default("active")
  /// Current step label inside the job (template-defined from Phase 5).
  state            String    @default("started")
  /// Optimistic concurrency: every transition bumps this; writers must present
  /// the version they read or the transition is rejected.
  stateVersion     Int       @default(1) @map("state_version")
  inputs           Json?
  facts            Json?
  artifacts        Json?
  /// Tool names legal from this state (router narrows packs with it).
  nextAllowedTools Json?     @map("next_allowed_tools")
  /// The approval card this run is blocked on (status waiting_owner).
  pendingActionId  String?   @map("pending_action_id")
  lastProof        Json?     @map("last_proof")
  retryCount       Int       @default(0) @map("retry_count")
  /// Execution lease — a worker/turn holding the lease may transition; others wait.
  leaseUntil       DateTime? @map("lease_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  completedAt      DateTime? @map("completed_at")

  @@index([conversationId, status])
  @@index([businessId, status])
  @@index([pendingActionId])
  @@map("workflow_runs")
}

/// Append-only transition log for WorkflowRun — every state/status change lands
/// here with its cause, so "how did this job get stuck" reads as one trace.
model WorkflowRunEvent {
  id            String   @id @default(uuid())
  workflowRunId String   @map("workflow_run_id")
  fromStatus    String?  @map("from_status")
  toStatus      String   @map("to_status")
  fromState     String?  @map("from_state")
  toState       String   @map("to_state")
  stateVersion  Int      @map("state_version")
  /// turn | approval | worker | auto | reconcile
  cause         String
  detail        Json?
  ts            DateTime @default(now())

  @@index([workflowRunId, ts])
  @@map("workflow_run_events")
}

/// Phase 56 — one row per connected external/internal service (the personal/
/// business OS adapter registry state). An adapter is NEVER 'ready' from OAuth
/// success alone — readiness requires its sandbox cases to pass first.
model AgentServiceConnection {
  id            String    @id @default(uuid())
  /// Adapter id, e.g. 'personal-records', 'erp-orders'.
  service       String    @unique
  /// personal | business
  scope         String
  /// disconnected | sandbox | connected | paused | revoked
  status        String    @default("disconnected")
  /// Least-privilege grants actually held (adapter capability ops subset).
  grantedOps    Json      @map("granted_ops")
  /// sandbox_pending | sandbox_passed | ready
  readiness     String    @default("sandbox_pending")
  health        Json?
  /// Retention window for data cached from this service.
  retentionDays Int       @default(90) @map("retention_days")
  connectedAt   DateTime? @map("connected_at")
  pausedAt      DateTime? @map("paused_at")
  revokedAt     DateTime? @map("revoked_at")
  dataDeletedAt DateTime? @map("data_deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([scope, status])
  @@map("agent_service_connections")
}

/// Phase 53 — one row per intended EXTERNAL EFFECT (the exactly-once unit).
/// State machine: proposed → policy_checked → awaiting_approval|claimed →
/// executing → verifying → succeeded; repair/terminal: denied, expired,
/// failed_retryable, failed_final, unknown_effect, compensating, compensated.
model AgentActionRun {
  id                String              @id @default(uuid())
  /// Deterministic exactly-once key (capability-token.buildIdempotencyKey).
  idempotencyKey    String              @unique @map("idempotency_key")
  /// Normalized effect hash (canonical input) — payload identity for approvals.
  effectHash        String              @map("effect_hash")
  tool              String
  surface           String              @default("owner")
  actor             String              @default("owner")
  instructionOrigin String              @default("owner_direct") @map("instruction_origin")
  conversationId    String?             @map("conversation_id")
  turnId            String?             @map("turn_id")
  businessId        String?             @map("business_id")
  riskTier          String              @map("risk_tier")
  policyVersion     String              @map("policy_version")
  approvalRef       String?             @map("approval_ref")
  state             String              @default("proposed")
  /// Optimistic concurrency — transitions must present the version they read.
  stateVersion      Int                 @default(1) @map("state_version")
  attempts          Int                 @default(0)
  input             Json
  destination       String?
  /// Provider receipt (message id / call sid / post id …).
  providerRef       String?             @map("provider_ref")
  /// Independent postcondition evidence (claim-verifier / re-read / receipt).
  proof             Json?
  /// Stored final result envelope for idempotent replay of completed runs.
  result            Json?
  costUsd           Float?              @map("cost_usd")
  /// Whole-taka money this effect commits (BDT rule — integers only).
  moneyTaka         Int?                @map("money_taka")
  error             String?             @db.Text
  /// Set when this run compensates (undoes) another run.
  compensationOfId  String?             @map("compensation_of_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  ledger            AgentEffectLedger[]

  @@index([state, updatedAt])
  @@index([conversationId, createdAt])
  @@index([tool, createdAt])
  @@map("agent_action_runs")
}

/// Phase 53 — APPEND-ONLY effect ledger. One row per transition/receipt/proof/
/// compensation evidence. Never updated, never deleted; ledger write failure
/// aborts the transition transaction (logging failure blocks the write).
model AgentEffectLedger {
  id        String         @id @default(uuid())
  runId     String         @map("run_id")
  run       AgentActionRun @relation(fields: [runId], references: [id])
  /// Per-run monotonic sequence — (runId, seq) unique makes the chain gapless.
  seq       Int
  /// transition | receipt | evidence | proof | compensation | note
  kind      String
  fromState String?        @map("from_state")
  toState   String?        @map("to_state")
  payload   Json?
  at        DateTime       @default(now())

  @@unique([runId, seq])
  @@index([runId, at])
  @@map("agent_effect_ledger")
}

/// Phase 53 — transactional outbox: dispatch intents committed atomically with
/// the action run; the VPS effect worker leases and dispatches them.
model AgentEffectOutbox {
  id          String    @id @default(uuid())
  runId       String    @unique @map("run_id")
  dueAt       DateTime  @default(now()) @map("due_at")
  leaseUntil  DateTime? @map("lease_until")
  leaseOwner  String?   @map("lease_owner")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([dueAt, leaseUntil])
  @@map("agent_effect_outbox")
}

model AgentTurn {
  id                    String    @id @default(uuid())
  conversationId        String    @map("conversation_id")
  /// Stable logical request id shared by direct + worker fallback paths.
  requestId             String?   @unique @map("request_id")
  /// A structured continuation has exactly one predecessor; unique prevents
  /// double-click/reconnect races from starting the same continuation twice.
  continuationOfTurnId  String?   @unique @map("continuation_of_turn_id")
  continuationNeeded    Boolean   @default(false) @map("continuation_needed")
  continuationClaimedAt DateTime? @map("continuation_claimed_at")
  status                String    @default("running") // running | done | error | canceled
  cancelRequested       Boolean   @default(false) @map("cancel_requested")
  /// Behavior-artifact versions live when this turn ran (Roadmap Phase 0):
  /// { prompt, toolManifest, router, workflow } — see src/agent/lib/agent-versions.ts.
  versions              Json?
  startedAt             DateTime  @default(now()) @map("started_at")
  finishedAt            DateTime? @map("finished_at")
  /// Client-generated idempotency key (roadmap Phase 3): one clientMessageId maps
  /// to at most ONE owner message and ONE turn, however many times the client
  /// retries after a timeout/reconnect. Nullable — legacy clients keep working.
  clientMessageId       String?   @map("client_message_id")
  /// The persisted owner AgentMessage this turn executes (set once — an internal
  /// worker re-run of the same turn must NOT store the message again).
  userMessageId         String?   @map("user_message_id")
  /// The persisted assistant AgentMessage of the terminal reply — lets the client
  /// fetch the exact final row instead of re-reading the whole history.
  assistantMessageId    String?   @map("assistant_message_id")
  /// Highest agent_turn_events.seq written for this turn (-1 = none yet) — the
  /// client's replay cursor and the "stream quiet but alive" liveness signal.
  lastSeq               Int       @default(-1) @map("last_seq")
  executionMode         String?   @map("execution_mode") // inline | worker
  /// Whose instruction this turn executes — owner_direct (he typed it) vs
  /// owner_policy (a standing policy / an unattended Plan-Driver step). The tool
  /// guard reads it so unattended work meets the autonomy ladder + money cap.
  instructionOrigin     String?   @map("instruction_origin")
  /// P0-2 (foundation audit H.5): append-only per-stage latency trace for this
  /// turn — [{ stage, at, ms }]. The approval path spans three processes
  /// (Vercel approve → Redis → VPS worker → chat route), so "approve to first
  /// visible work took 90s" was unattributable. Each stage stamps itself.
  stageTrace            Json?     @map("stage_trace")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([conversationId, clientMessageId])
  @@index([clientMessageId])
  @@index([conversationId, startedAt(sort: Desc)])
  @@index([status, continuationNeeded, finishedAt(sort: Desc)])
  @@map("agent_turns")
}

/// Durable, exactly-once owner push for a completed agent turn. The chat route
/// enqueues before delivery; the VPS sweeper retries transient failures.
model AgentTurnNotificationDelivery {
  id             String    @id @default(uuid())
  turnId         String    @unique @map("turn_id")
  conversationId String    @map("conversation_id")
  preview        String?   @db.Text
  /// pending | processing | retry | delivered | suppressed | dead
  status         String    @default("pending")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at")
  leaseUntil     DateTime? @map("lease_until")
  deliveredAt    DateTime? @map("delivered_at")
  lastError      String?   @map("last_error") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("agent_turn_notification_deliveries")
}

/// Append-only event log for a worker-executed (VPS) turn (Component A2). A turn
/// that runs on the VPS worker — for genuinely long jobs that can't fit Vercel's
/// 300s cap — publishes each SSE event both to a Redis pub/sub channel
/// (`turn:<id>:events`, for live tailing) and as a row here (for replay). When the
/// client (re)connects to the stream endpoint it first replays these rows in `seq`
/// order, then tails Redis for anything newer — so reconnects never lose events.
model AgentTurnEvent {
  id        String   @id @default(uuid())
  turnId    String   @map("turn_id")
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([turnId, seq])
  @@index([turnId, seq])
  @@map("agent_turn_events")
}

/// Rich output produced by the agent (code, markdown, HTML, images).
model AgentArtifact {
  id             String                 @id @default(uuid())
  conversationId String
  conversation   AgentConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        AgentMessage?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  type           String?
  title          String?
  content        String?                @db.Text
  version        Int                    @default(1)
  createdAt      DateTime               @default(now())
  versions       AgentArtifactVersion[]

  @@index([conversationId])
  @@index([messageId])
  @@map("agent_artifacts")
}

/// Snapshot of an artifact body BEFORE an in-place update overwrote it —
/// the artifacts panel's version history (Claude-app parity, 2026-07-16).
model AgentArtifactVersion {
  id         String        @id @default(uuid())
  artifactId String
  artifact   AgentArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  version    Int
  type       String?
  title      String?
  content    String?       @db.Text
  createdAt  DateTime      @default(now())

  @@unique([artifactId, version])
  @@index([artifactId])
  @@map("agent_artifact_versions")
}

/// Owner's memory store. pgvector embedding column added in Phase 3.
model AgentMemory {
  id          String                       @id @default(uuid())
  scope       String
  key         String?
  content     String                       @db.Text
  pinned      Boolean                      @default(false)
  metadata    Json?
  embedding   Unsupported("vector(1536)")?
  importance  Int                          @default(2)
  accessCount Int                          @default(0) @map("access_count")
  lastUsedAt  DateTime?                    @map("last_used_at")
  /// Day-scoped/temporary facts stop being injected/retrieved after this moment;
  /// the weekly memory revision hard-deletes them. NULL = permanent fact.
  expiresAt   DateTime?                    @map("expires_at")
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([scope])
  @@map("agent_memory")
}

/// Distilled memory layers (owner-approved 2026-08-03). Flat facts answer "what
/// was said"; these answer "what is the situation" without paying for every fact
/// row. L2 = one scenario block per topic, L3 = one standing persona block per
/// scope. DERIVED data — rebuilt weekly from AgentMemory, never hand-authored,
/// so dropping the table loses nothing permanent.
model AgentMemoryDigest {
  id          String                       @id @default(uuid())
  /// 'L2' (scenario) | 'L3' (persona)
  layer       String
  /// 'personal' | 'business' — matches the retrieval mode
  scope       String
  /// NULL for personal blocks; the business for business blocks
  businessId  String?                      @map("business_id")
  topic       String
  content     String                       @db.Text
  embedding   Unsupported("vector(1536)")?
  sourceCount Int                          @default(0) @map("source_count")
  sourceIds   Json?                        @map("source_ids")
  refreshedAt DateTime                     @default(now()) @map("refreshed_at")
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([layer, scope])
  @@map("agent_memory_digest")
}

/// Answer Gate (owner decision 2026-07-08): verified reusable Q&A pairs served
/// in front of EXPENSIVE heads only (Gemini/Opus-class). Cheap heads bypass.
model AgentQaCache {
  id           String                       @id @default(uuid())
  scope        String                       @default("business")
  question     String                       @db.Text
  answer       String                       @db.Text
  embedding    Unsupported("vector(1536)")?
  sourceModel  String?                      @map("source_model")
  hits         Int                          @default(0)
  lastServedAt DateTime?                    @map("last_served_at")
  verifiedAt   DateTime?                    @map("verified_at")
  expiresAt    DateTime?                    @map("expires_at")
  active       Boolean                      @default(true)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@index([scope, active])
  @@map("agent_qa_cache")
}

/// Graph-memory (Task B): directed relationship edges between business entities
/// (customer/order/staff/product/topic). Layered over semantic memory to enable
/// entity-centric recall via traversal. Learned knowledge only — not a mirror of
/// ERP tables. Business-scoped; one triple per business is a single weighted row.
model AgentKnowledgeEdge {
  id           String    @id @default(uuid())
  subjectType  String    @map("subject_type")
  subjectId    String    @map("subject_id")
  subjectLabel String?   @map("subject_label")
  predicate    String
  objectType   String    @map("object_type")
  objectId     String    @map("object_id")
  objectLabel  String?   @map("object_label")
  weight       Int       @default(1)
  note         String?
  businessId   String    @default("ALMA_LIFESTYLE") @map("business_id")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastSeenAt   DateTime? @map("last_seen_at")

  @@unique([businessId, subjectType, subjectId, predicate, objectType, objectId], name: "edge_triple")
  @@index([businessId, subjectType, subjectId])
  @@index([businessId, objectType, objectId])
  @@map("agent_knowledge_edge")
}

/// Execution record for every tool the agent invokes.
model AgentToolCall {
  id         String        @id @default(uuid())
  messageId  String?
  message    AgentMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  toolName   String
  input      Json?
  output     Json?
  status     String?
  durationMs Int?
  error      String?
  createdAt  DateTime      @default(now())

  @@index([messageId])
  @@map("agent_tool_calls")
}

/// Costly/destructive actions pending owner confirmation before execution.
model AgentPendingAction {
  id             String    @id @default(uuid())
  conversationId String?
  /// Optional logical-task key for tools whose expensive side effect must be
  /// exactly-once across model retries/continuations.
  dedupeKey      String?   @unique @map("dedupe_key")
  type           String
  payload        Json
  summary        String    @db.Text
  costEstimate   Float?
  status         String    @default("pending")
  /// Business scope for routing/filtering ('ALMA_LIFESTYLE' | 'ALMA_TRADING').
  businessId     String    @default("ALMA_LIFESTYLE") @map("business_id")
  createdAt      DateTime  @default(now())
  /// When the row SETTLED — set by the approve/reject routes AND by the worker's
  /// job-result callback. It does NOT mean Boss decided anything.
  resolvedAt     DateTime?
  /// Did BOSS decide this? Only the approve/reject routes set it, and both
  /// refuse a row that is not 'pending' — so a row created already-approved (a
  /// read-only crawl, a queued generation) can never be marked his.
  /// NULL = unknown provenance (history written before this column).
  ownerDecided   Boolean?  @map("owner_decided")
  result         Json?
  /// Immutable per-action image engine selection. Kept outside payload so an
  /// owner model change cannot be lost by a concurrent progress JSON update.
  imageModel     String?   @map("image_model")
  /// Render-only USD estimate/range pinned with imageModel. Actual worker
  /// spend remains in result.costUsd after execution.
  imageQuote     Json?     @map("image_quote")
  /// Build 103 Issue 2 — canonical v2 render selection (preset, aspect, exact
  /// server-resolved dimensions, quality, variation count). Null = legacy v1
  /// card; loose payload fields stay a backward-compatible mirror only.
  imageConfig    Json?     @map("image_config")
  /// Monotonic compare-and-set revision for imageConfig. Every accepted edit
  /// increments it; approval snapshots the revision it claimed.
  imageConfigRevision Int  @default(0) @map("image_config_revision")
  /// Short compare-and-set claim used while an image approval request creates
  /// its one progress turn. A stale claim is recoverable; workers never poll it.
  approvalClaimedAt DateTime? @map("approval_claimed_at")
  /// Worker-owned durable terminal callback outbox. It is set before the app
  /// callback and cleared only after server delivery/reconciliation succeeds.
  jobResultPending Boolean @default(false) @map("job_result_pending")
  jobResultEnvelope Json? @map("job_result_envelope")
  /// Stale-safe server reconciliation lease. The terminal receipt remains
  /// pending until the exact claimant finishes every delivery/runtime effect.
  jobResultClaimedAt DateTime? @map("job_result_claimed_at")
  /// Phase 4: canonical WorkflowRun this card belongs to (camelCase column —
  /// this legacy table is camelCase in the DB).
  workflowRunId  String?

  @@index([status])
  @@index([conversationId])
  @@index([businessId, status])
  @@map("agent_pending_actions")
}

/// Media mode (CapCut-class video engine) — one row per video project.
/// planJson holds the versioned MediaPlan contract (docs/MEDIA_MODE_ROADMAP.md §4);
/// the server-side cost estimator recomputes estimate lines, never the LLM.
model AgentMediaProject {
  id               String    @id @default(uuid())
  conversationId   String?   @map("conversation_id")
  title            String
  /// draft | planned | approved | rendering | review | final | failed | cancelled
  status           String    @default("draft")
  planJson         Json      @map("plan_json")
  /// Monotonic revision — every accepted plan revision (আমার মত) increments it.
  planRevision     Int       @default(0) @map("plan_revision")
  aspect           String    @default("9:16")
  language         String    @default("bn")
  totalEstimateUsd Float?    @map("total_estimate_usd")
  totalActualUsd   Float?    @map("total_actual_usd")
  finalAssetPath   String?   @map("final_asset_path")
  pendingActionId  String?   @map("pending_action_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  scenes AgentMediaScene[]
  assets AgentMediaAsset[]

  @@index([status])
  @@index([conversationId])
  @@map("agent_media_projects")
}

model AgentMediaScene {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  idx         Int
  brief       String   @db.Text
  voScript    String?  @map("vo_script") @db.Text
  imagePrompt String?  @map("image_prompt") @db.Text
  clipBrief   String?  @map("clip_brief") @db.Text
  durationSec Float    @map("duration_sec")
  /// planned | rendering | ready | failed
  status      String   @default("planned")
  createdAt   DateTime @default(now()) @map("created_at")

  project AgentMediaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, idx])
  @@map("agent_media_scenes")
}

/// Every generated artifact, versioned — regenerate bumps version, stitch always
/// consumes the newest `ready` version per scene.
model AgentMediaAsset {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  sceneId     String?  @map("scene_id")
  /// vo | music | sfx | image | clip | stitch | final
  kind        String
  version     Int      @default(1)
  /// queued | rendering | ready | failed | superseded
  status      String   @default("queued")
  jobId       String?  @map("job_id")
  storagePath String?  @map("storage_path")
  mimeType    String?  @map("mime_type")
  durationSec Float?   @map("duration_sec")
  costUsd     Float?   @map("cost_usd")
  modelId     String?  @map("model_id")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project AgentMediaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, status])
  @@index([sceneId])
  @@map("agent_media_assets")
}

model FamilyContact {
  id        String   @id @default(uuid())
  ownerId   String?  @map("owner_id")
  name      String
  relation  String
  phone     String
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("family_contacts")
}

model AgentNotification {
  id        String   @id @default(uuid())
  tier      Int
  category  String?
  title     String   @db.Text
  message   String   @db.Text
  channels  Json
  statuses  Json
  createdAt DateTime @default(now())

  @@index([tier])
  @@index([createdAt])
  @@map("agent_notifications")
}

// ─── PHASE 9: Personal Reminders ──────────────────────────────────────────────

model AgentReminder {
  id                   String    @id @default(uuid())
  title                String
  body                 String?   @db.Text
  dueAt                DateTime  @map("due_at")
  recurrenceRrule      String?   @map("recurrence_rrule")
  tier                 Int       @default(1)
  voice                Boolean   @default(true)
  status               String    @default("pending")
  snoozedUntil         DateTime? @map("snoozed_until")
  lastSentAt           DateTime? @map("last_sent_at")
  sendCount            Int       @default(0) @map("send_count")
  sourceConversationId String?   @map("source_conversation_id")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([status, dueAt])
  @@index([dueAt])
  @@map("agent_reminders")
}

model AgentOwnerTodo {
  id                   String    @id @default(uuid())
  title                String
  detail               String?   @db.Text
  status               String    @default("open")
  priority             String    @default("normal")
  dueHint              String?   @map("due_hint")
  nudgeAfterDays       Int       @default(3) @map("nudge_after_days")
  lastNudgedAt         DateTime? @map("last_nudged_at")
  sourceConversationId String?   @map("source_conversation_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  completedAt          DateTime? @map("completed_at")

  @@index([status, createdAt])
  @@map("agent_owner_todos")
}

model ProductContentAsset {
  id           String    @id @default(uuid())
  productCode  String    @map("product_code")
  name         String?
  category     String?
  fabric       String?   @db.Text
  imagePath    String    @map("image_path")
  familyMatch  Boolean   @default(false) @map("family_match")
  lastPostedAt DateTime? @map("last_posted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([lastPostedAt])
  @@index([productCode])
  @@map("product_content_asset")
}

model BrandAsset {
  id        String   @id @default(uuid())
  kind      String   @unique
  path      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brand_asset")
}

// ─── Creative Studio Enterprise CSE3: Content OS ────────────────────────────
// Owner-scoped project/recipe records intentionally do not point back into ERP
// product tables. Product data is copied as a read-only snapshot when selected,
// so Studio can never mutate a live ERP product through these relationships.

model CreativeBrandProfile {
  id                        String                         @id @default(uuid())
  ownerId                   String                         @map("owner_id")
  name                      String
  organization              String?
  notes                     String?                        @db.Text
  approvalSpendThresholdBdt Int                            @default(0) @map("approval_spend_threshold_bdt")
  createdAt                 DateTime                       @default(now()) @map("created_at")
  updatedAt                 DateTime                       @updatedAt @map("updated_at")
  recipes                   CreativeBrandRecipe[]
  projects                  CreativeProject[]
  roleAssignments           CreativeStudioRoleAssignment[]
  reviewComments            CreativeAssetReviewComment[]
  reviewEvents              CreativeAssetReviewEvent[]
  publishDeliveries         CreativePublishDelivery[]
  compositions              CreativeComposition[]
  lifecycleJobs             CreativeLifecycleJob[]         @relation("CreativeLifecycleJobBrandScope")
  lifecycleFlags            CreativeLifecycleFeatureFlag[] @relation("CreativeLifecycleFlagBrandScope")

  @@unique([ownerId, name])
  @@unique([id, ownerId])
  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("creative_brand_profiles")
}

model CreativeBrandRecipe {
  id                 String                            @id @default(uuid())
  ownerId            String                            @map("owner_id")
  brandProfileId     String                            @map("brand_profile_id")
  brandProfile       CreativeBrandProfile              @relation(fields: [brandProfileId], references: [id], onDelete: Restrict)
  recipeKey          String                            @map("recipe_key")
  version            Int                               @default(1)
  name               String
  sceneSubset        Json                              @default("[]") @map("scene_subset")
  modelRoles         Json                              @default("[]") @map("model_roles")
  finishTheme        String                            @default("default") @map("finish_theme")
  captionTone        String                            @default("premium") @map("caption_tone")
  aspectPack         Json                              @default("[\"4:5\"]") @map("aspect_pack")
  musicVibe          String                            @default("premium") @map("music_vibe")
  qcLevel            String                            @default("strict") @map("qc_level")
  spendCeilingBdt    Int                               @default(0) @map("spend_ceiling_bdt")
  lockedAt           DateTime?                         @map("locked_at")
  lockedById         String?                           @map("locked_by_id")
  createdAt          DateTime                          @default(now()) @map("created_at")
  updatedAt          DateTime                          @updatedAt @map("updated_at")
  projects           CreativeProject[]                 @relation("CreativeProjectRecipe")
  assetVersions      CreativeAssetVersion[]
  publishDeliveries  CreativePublishDelivery[]
  performanceWeights CreativeRecipePerformanceWeight[]

  @@unique([brandProfileId, recipeKey, version])
  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([brandProfileId, recipeKey, version(sort: Desc)])
  @@map("creative_brand_recipes")
}

model CreativeProject {
  id                 String                         @id @default(uuid())
  ownerId            String                         @map("owner_id")
  name               String
  description        String?                        @db.Text
  brandProfileId     String?                        @map("brand_profile_id")
  brandProfile       CreativeBrandProfile?          @relation(fields: [brandProfileId], references: [id], onDelete: Restrict)
  currentRecipeId    String?                        @map("current_recipe_id")
  currentRecipe      CreativeBrandRecipe?           @relation("CreativeProjectRecipe", fields: [currentRecipeId], references: [id], onDelete: SetNull)
  productCode        String?                        @map("product_code")
  productName        String?                        @map("product_name")
  productPriceBdt    Int?                           @map("product_price_bdt")
  productSourceImage String?                        @map("product_source_image") @db.Text
  defaultFolder      String                         @default("Unsorted") @map("default_folder")
  archivedAt         DateTime?                      @map("archived_at")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")
  assets             CreativeProjectAsset[]
  publishDeliveries  CreativePublishDelivery[]
  compositions       CreativeComposition[]
  lifecycleJobs      CreativeLifecycleJob[]         @relation("CreativeLifecycleJobProjectScope")
  lifecycleFlags     CreativeLifecycleFeatureFlag[] @relation("CreativeLifecycleFlagProjectScope")

  @@unique([id, ownerId, brandProfileId])
  @@index([ownerId, archivedAt, updatedAt(sort: Desc)])
  @@index([brandProfileId])
  @@index([currentRecipeId])
  @@map("creative_projects")
}

model CreativeProjectAsset {
  id                String                       @id @default(uuid())
  projectId         String                       @map("project_id")
  project           CreativeProject              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pendingActionId   String?                      @map("pending_action_id")
  assetType         String                       @default("image") @map("asset_type")
  title             String?
  folder            String                       @default("Unsorted")
  latestStoragePath String?                      @map("latest_storage_path") @db.Text
  reviewState       CreativeAssetReviewState     @default(DRAFT) @map("review_state")
  reviewSequence    Int                          @default(0) @map("review_sequence")
  createdById       String                       @map("created_by_id")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  versions          CreativeAssetVersion[]
  lineageSources    CreativeAssetLineage[]       @relation("CreativeLineageSource")
  tagAssignments    CreativeProjectAssetTag[]
  reviewComments    CreativeAssetReviewComment[]
  reviewEvents      CreativeAssetReviewEvent[]
  publishDeliveries CreativePublishDelivery[]

  @@unique([projectId, pendingActionId])
  @@index([projectId, folder, updatedAt(sort: Desc)])
  @@index([pendingActionId])
  @@index([createdById])
  @@map("creative_project_assets")
}

model CreativeAssetVersion {
  id                    String                        @id @default(uuid())
  assetId               String                        @map("asset_id")
  asset                 CreativeProjectAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version               Int
  storagePath           String?                       @map("storage_path") @db.Text
  recipeId              String?                       @map("recipe_id")
  recipe                CreativeBrandRecipe?          @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeVersion         Int?                          @map("recipe_version")
  provider              String?
  engine                String?
  jobId                 String?                       @map("job_id")
  costBdt               Int                           @default(0) @map("cost_bdt")
  costUsd               Decimal?                      @map("cost_usd") @db.Decimal(12, 6)
  qc                    Json?
  metadata              Json                          @default("{}")
  createdById           String                        @map("created_by_id")
  createdAt             DateTime                      @default(now()) @map("created_at")
  lineage               CreativeAssetLineage[]
  publishDeliveries     CreativePublishDelivery[]
  performanceSnapshots  CreativePerformanceSnapshot[]
  archiveReceipts       CreativeArchiveReceipt[]
  compositionNodes      CreativeCompositionNode[]
  lifecycleSourceJobs   CreativeLifecycleJob[]        @relation("CreativeLifecycleSourceArtifact")
  lifecycleApprovedJobs CreativeLifecycleJob[]        @relation("CreativeLifecycleApprovedArtifact")
  lifecycleResultJobs   CreativeLifecycleJob[]        @relation("CreativeLifecycleResultArtifact")
  lifecycleReceipts     CreativeLifecycleReceipt[]
  reviewApprovals       CreativeAssetReviewEvent[]    @relation("CreativeReviewApprovedArtifact")

  @@unique([assetId, version])
  @@index([recipeId])
  @@index([jobId])
  @@map("creative_asset_versions")
}

model CreativeAssetLineage {
  id            String               @id @default(uuid())
  versionId     String               @map("version_id")
  version       CreativeAssetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sourceAssetId String               @map("source_asset_id")
  sourceAsset   CreativeProjectAsset @relation("CreativeLineageSource", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  relationKind  String               @default("derived_from") @map("relation_kind")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@unique([versionId, sourceAssetId, relationKind])
  @@index([sourceAssetId])
  @@map("creative_asset_lineage")
}

model CreativeAssetTag {
  id          String                    @id @default(uuid())
  ownerId     String                    @map("owner_id")
  name        String
  slug        String
  color       String                    @default("clay")
  createdAt   DateTime                  @default(now()) @map("created_at")
  assignments CreativeProjectAssetTag[]

  @@unique([ownerId, slug])
  @@index([ownerId, name])
  @@map("creative_asset_tags")
}

model CreativeProjectAssetTag {
  assetId String               @map("asset_id")
  asset   CreativeProjectAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tagId   String               @map("tag_id")
  tag     CreativeAssetTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@index([tagId])
  @@map("creative_project_asset_tags")
}

// ─── Creative Studio Enterprise CSE6: review and multi-brand ───────────────

enum CreativeStudioRole {
  OWNER
  CREATOR
  REVIEWER
}

enum CreativeAssetReviewState {
  DRAFT
  CHANGES_REQUESTED
  REVISED
  APPROVED
}

model CreativeStudioRoleAssignment {
