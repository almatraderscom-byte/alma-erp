generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR
  STAFF
  VIEWER
}

model User {
  id                               String                            @id @default(cuid())
  email                            String?                           @unique
  passwordHash                     String
  name                             String
  phone                            String?                           @unique
  role                             UserRole                          @default(STAFF)
  active                           Boolean                           @default(true)
  /// Comma-separated BusinessId: ALMA_LIFESTYLE,CREATIVE_DIGITAL_IT,ALMA_TRADING
  businessAccess                   String                            @default("ALMA_LIFESTYLE,CREATIVE_DIGITAL_IT,ALMA_TRADING")
  employeeIdGas                    String?
  joiningDate                      DateTime?
  salaryHint                       Decimal?                          @db.Decimal(12, 2)
  profileImageUrl                  String?
  offboardedAt                     DateTime?
  hrOffboardedAt                   DateTime?
  offboardedBy                     String?
  offboardingReason                String?                           @db.Text
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  advanceRequests                  SalaryAdvanceRequest[]
  mealAllowanceProfiles            MealAllowanceProfile[]
  mealAllowanceRequests            MealAllowanceRequest[]
  drivingModeProfiles              DrivingModeProfile[]
  drivingModeSessions              DrivingModeSession[]
  passwordResetTokens              PasswordResetToken[]
  assignedTradingAccounts          TradingAccount[]                  @relation("TradingAccountAssignedUser")
  tradingTrades                    TradingTrade[]                    @relation("TradingTradeUser")
  tradingExpensesCreated           TradingExpense[]                  @relation("TradingExpenseCreatedBy")
  tradingPartnershipSettlements    TradingPartnershipSettlement[]    @relation("TradingPartnershipSettledBy")
  tradingCapitalCreated            TradingCapitalEntry[]             @relation("TradingCapitalCreatedBy")
  tradingBkashCreated              TradingBkashDailySummary[]        @relation("TradingBkashSummaryCreatedBy")
  tradingPerformanceShots          TradingPerformanceScreenshot[]    @relation("TradingPerformanceUploadedBy")
  tradingEmployeeProfile           TradingEmployeeProfile?           @relation("TradingEmployeeProfileUser")
  tradingDailyReports              TradingEmployeeDailyReport[]      @relation("TradingEmployeeDailyReportUser")
  attendanceRecords                AttendanceRecord[]                @relation("AttendanceRecordUser")
  attendanceWaivers                AttendanceWaiverRequest[]         @relation("AttendanceWaiverRequester")
  attendanceReviews                AttendanceWaiverRequest[]         @relation("AttendanceWaiverReviewer")
  attendanceSelfies                AttendanceSelfieVerification[]    @relation("AttendanceSelfieUser")
  tradingTelegramLinks             TradingTelegramUser[]             @relation("TradingTelegramErpUser")
  tradingTelegramDrafts            TradingTelegramDraft[]            @relation("TradingTelegramDraftErpUser")
  operationalTasksCreated          OperationalTask[]                 @relation("OperationalTaskCreator")
  operationalTaskAssignments       OperationalTaskAssignment[]       @relation("OperationalTaskAssignee")
  operationalTaskAcks              OperationalTaskAcknowledgement[]  @relation("OperationalTaskAckUser")
  paymentMethods                   EmployeePaymentMethod[]           @relation("UserPaymentMethods")
  agentStaffLinks                  AgentStaff[]                      @relation("AgentStaffUser")
  creativeStudioRoles              CreativeStudioRoleAssignment[]    @relation("CreativeStudioRoleUser")
  creativeStudioRolesGranted       CreativeStudioRoleAssignment[]    @relation("CreativeStudioRoleGrantor")
  creativeReviewComments           CreativeAssetReviewComment[]      @relation("CreativeReviewCommentAuthor")
  creativeReviewEvents             CreativeAssetReviewEvent[]        @relation("CreativeReviewEventActor")
  creativeCompositionsCreated      CreativeComposition[]             @relation("CreativeCompositionCreator")
  creativeVersionsCreated          CreativeCompositionVersion[]      @relation("CreativeCompositionVersionCreator")
  creativeOperationBatches         CreativeOperationBatch[]          @relation("CreativeOperationBatchActor")
  creativeEditOperations           CreativeEditOperation[]           @relation("CreativeEditOperationActor")
  creativeRollbackPoints           CreativeRollbackPoint[]           @relation("CreativeRollbackPointActor")
  creativeLifecycleJobsOwned       CreativeLifecycleJob[]            @relation("CreativeLifecycleJobOwner")
  creativeLifecycleJobsCreated     CreativeLifecycleJob[]            @relation("CreativeLifecycleJobCreator")
  creativeLifecycleAudits          CreativeLifecycleAuditEvent[]     @relation("CreativeLifecycleAuditActor")
  creativeLifecycleFlagsOwned      CreativeLifecycleFeatureFlag[]    @relation("CreativeLifecycleFlagOwner")
  creativeLifecycleFlagsUpdated    CreativeLifecycleFeatureFlag[]    @relation("CreativeLifecycleFlagUpdater")
  creativeLifecycleFlagAuditsOwned CreativeLifecycleFlagAuditEvent[] @relation("CreativeLifecycleFlagAuditOwner")
  creativeLifecycleFlagAudits      CreativeLifecycleFlagAuditEvent[] @relation("CreativeLifecycleFlagAuditActor")

  @@index([active, role])
  @@index([active, createdAt])
  @@index([employeeIdGas])
  @@index([businessAccess])
  @@index([offboardedAt])
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeeLedgerEntryType {
  SALARY_ACCRUAL
  ADVANCE
  WITHDRAWAL
  ADJUSTMENT
  COMMISSION
  EID_BONUS
  PERFORMANCE_BONUS
  MEAL_DEDUCTION
  MEAL_ALLOWANCE
  OVERTIME
  REIMBURSEMENT
  /// Legacy generic bonus rows are still readable; new compensation should use specific bonus types.
  BONUS
  PENALTY
  /// Advance salary credited INTO the wallet (money in) — raises the withdrawable balance.
  ADVANCE_DISBURSEMENT
  /// Auto-recovery of an outstanding advance from the next month's salary accrual (money out).
  ADVANCE_RECOVERY
}

enum WalletRequestType {
  ADVANCE
  WITHDRAWAL
}

enum WalletRequestStatus {
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

enum AttendanceRecordStatus {
  PRESENT
  LATE
  COMPLETED
  EARLY_LEAVE
}

enum AttendanceWaiverStatus {
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceWaiverRequestType {
  FULL_WAIVE
  PARTIAL_REDUCE
  RECONSIDERATION
}

enum AttendanceTrustStatus {
  TRUSTED
  WARNING
  REQUIRES_VERIFICATION
}

enum AttendanceExceptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceLeaveKind {
  FULL_DAY
  DATE_RANGE
  HOURS
  SHIFTED_START
}

enum PayrollAccrualRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum NotificationType {
  SALARY_ADDED
  ACCRUAL_FAILED
  WALLET_REQUEST_APPROVED
  WALLET_REQUEST_REJECTED
  ADMIN_ANNOUNCEMENT
  INVOICE_CREATED
  ORDER_ASSIGNED
  LOW_STOCK
  PAYROLL_ALERT
  EXPENSE_ADDED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum InvoiceEventType {
  CREATED
  REGENERATED
  OPENED
  SHARED
  DELETED
}

enum TradingAccountStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CLOSED
}

enum TradingAccountType {
  BINANCE_P2P
  MERCHANT
  STAFF_OPERATED
  OTHER
}

enum TradingCapitalEntryType {
  DEPOSIT
  WITHDRAW
  ADJUSTMENT
}

enum TradingTradeType {
  BUY
  SELL
}

enum TradingCommissionType {
  NONE
  PERCENTAGE
  FIXED
}

enum TradingExpensePaidBy {
  OWNER
  STAFF
}

model SalaryAdvanceRequest {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String
  amount       Decimal       @db.Decimal(12, 2)
  reason       String        @db.Text
  status       AdvanceStatus @default(PENDING)
  reviewedById String?
  reviewNote   String?       @db.Text
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())

  @@index([status])
  @@index([userId])
}

model EmployeeLedgerEntry {
  id              String                  @id @default(cuid())
  employeeId      String
  userId          String?
  businessId      String
  date            DateTime
  periodYm        String?
  type            EmployeeLedgerEntryType
  amount          Decimal                 @db.Decimal(12, 2)
  note            String?                 @db.Text
  createdById     String?
  approvedById    String?
  source          String?
  sourceRef       String?
  walletRequestId String?
  /// For refund/settlement entries (e.g. an ADJUSTMENT that returns a PENALTY):
  /// id of the original ledger entry being settled — direct fine ↔ refund join.
  relatedEntryId  String?
  isArchived      Boolean                 @default(false)
  archivedAt      DateTime?
  archivedById    String?
  archiveBatchId  String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([employeeId, businessId, periodYm, type])
  @@unique([source, sourceRef])
  @@index([businessId, isArchived, createdAt])
  @@index([employeeId, businessId, date])
  @@index([employeeId, businessId, periodYm])
  @@index([businessId, type])
  @@index([businessId, periodYm])
  @@index([businessId, createdAt])
  @@index([businessId, employeeId, createdAt])
  @@index([userId])
  @@index([relatedEntryId])
}

enum EmployeePaymentMethodType {
  MOBILE_BANKING
  BANK_ACCOUNT
}

enum MobileMoneyProvider {
  BKASH
  NAGAD
  ROCKET
  OTHER
}

enum PaymentAccountUsage {
  PERSONAL
  BUSINESS
}

enum PaymentMethodStatus {
  ACTIVE
  DISABLED
  SUSPICIOUS
  ARCHIVED
}

model EmployeePaymentMethod {
  id                String                          @id @default(cuid())
  userId            String
  user              User                            @relation("UserPaymentMethods", fields: [userId], references: [id], onDelete: Cascade)
  businessId        String
  type              EmployeePaymentMethodType
  provider          MobileMoneyProvider?
  usageType         PaymentAccountUsage?
  accountHolderName String
  accountNumber     String
  bankName          String?
  branchName        String?
  routingNumber     String?
  qrImageUrl        String?                         @db.Text
  isPrimary         Boolean                         @default(false)
  isVerified        Boolean                         @default(false)
  verifiedAt        DateTime?
  verifiedById      String?
  status            PaymentMethodStatus             @default(ACTIVE)
  suspiciousNote    String?                         @db.Text
  isArchived        Boolean                         @default(false)
  archivedAt        DateTime?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  auditLogs         EmployeePaymentMethodAuditLog[]

  @@index([userId, businessId, isArchived])
  @@index([userId, isPrimary])
  @@index([businessId, status])
}

model EmployeePaymentMethodAuditLog {
  id              String                 @id @default(cuid())
  paymentMethodId String?
  paymentMethod   EmployeePaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  userId          String
  businessId      String
  actorUserId     String
  action          String
  detailJson      String?                @db.Text
  createdAt       DateTime               @default(now())

  @@index([userId, createdAt])
  @@index([paymentMethodId, createdAt])
}

model WalletRequest {
  id              String              @id @default(cuid())
  userId          String
  employeeId      String
  businessId      String
  type            WalletRequestType
  status          WalletRequestStatus @default(PENDING)
  requestedAmount Decimal             @db.Decimal(12, 2)
  approvedAmount  Decimal?            @db.Decimal(12, 2)
  reason          String              @db.Text
  paymentMethodId String?
  /// How the money was actually handed over at approval (CASH/BKASH/NAGAD/BANK).
  paidVia         String?
  reviewNote      String?             @db.Text
  reviewedById    String?
  reviewedAt      DateTime?
  ledgerEntryId   String?
  transactionId   String?
  isArchived      Boolean             @default(false)
  archivedAt      DateTime?
  archivedById    String?
  archiveBatchId  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([businessId, isArchived, createdAt])
  @@index([status])
  @@index([userId])
  @@index([employeeId, businessId])
  @@index([businessId, type])
  @@index([businessId, status, createdAt])
  @@index([userId, status, createdAt])
}

/// Per-day acknowledgement log for the staff "outstanding advance" profile notice.
/// One row per staff member per Asia/Dhaka day; proof the staff saw the recovery notice.
model AdvanceNoticeAck {
  id               String   @id @default(cuid())
  userId           String
  employeeId       String
  businessId       String
  ackDate          String
  outstandingAtAck Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  @@unique([userId, businessId, ackDate])
  @@index([employeeId, businessId])
}

model MealAllowanceProfile {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  employeeId  String
  enabled     Boolean  @default(false)
  amountBdt   Decimal  @db.Decimal(12, 2)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model MealAllowanceRequest {
  id            String   @id @default(cuid())
  userId        String
  businessId    String
  employeeId    String
  allowanceDate DateTime
  amountBdt     Decimal  @db.Decimal(12, 2)
  reason        String   @db.Text
  status        String   @default("PENDING")
  ledgerEntryId String?
  reviewedById  String?
  approvalId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([userId, businessId])
  @@index([userId, businessId, allowanceDate])
}

/// Per-staff "Driving Mode" capability — owner enables it for a staff member,
/// mirroring MealAllowanceProfile. When enabled, the staff can request driving
/// mode from MyDesk; on approval the agent pauses their office follow-ups.
model DrivingModeProfile {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  employeeId  String
  enabled     Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

/// A driving-mode session. PENDING (awaiting owner approval) → ACTIVE (staff is
/// out driving; office follow-ups paused) → ENDED (resumed) or REJECTED.
model DrivingModeSession {
  id              String    @id @default(cuid())
  userId          String
  businessId      String
  employeeId      String
  staffId         String?
  status          String    @default("PENDING")
  reason          String?   @db.Text
  initiatedBy     String    @default("staff")
  startedAt       DateTime  @default(now())
  approvedAt      DateTime?
  endedAt         DateTime?
  endedBy         String?
  approvalId      String?
  reviewedById    String?
  welcomeBackSent Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, businessId, status])
  @@index([businessId, status])
  @@index([staffId, status])
}

model AttendanceRecord {
  id                             String                         @id @default(cuid())
  businessId                     String
  userId                         String
  user                           User                           @relation("AttendanceRecordUser", fields: [userId], references: [id], onDelete: Cascade)
  employeeId                     String
  attendanceDate                 DateTime
  status                         AttendanceRecordStatus         @default(PRESENT)
  officeStartMinutes             Int                            @default(540)
  officeEndMinutes               Int                            @default(1260)
  checkInAt                      DateTime
  checkOutAt                     DateTime?
  totalWorkMinutes               Int                            @default(0)
  lateMinutes                    Int                            @default(0)
  penaltyAmount                  Decimal                        @default(0) @db.Decimal(12, 2)
  penaltyLedgerEntryId           String?
  earlyLeaveMinutes              Int?
  earlyLeavePenaltyAmount        Decimal?                       @db.Decimal(12, 2)
  earlyLeavePenaltyLedgerEntryId String?
  deviceInfo                     String?                        @db.Text
  sessionInfo                    String?                        @db.Text
  ipHash                         String?
  browserFingerprint             String?
  deviceKey                      String?
  sessionId                      String?
  latitude                       Decimal?                       @db.Decimal(10, 7)
  longitude                      Decimal?                       @db.Decimal(10, 7)
  locationAccuracyM              Int?
  distanceFromOfficeM            Int?
  /// GPS captured at check-OUT (separate from check-in). Audit trail for the
  /// checkout geofence gate so a fine appeal can verify where the staff was.
  checkOutLatitude               Decimal?                       @db.Decimal(10, 7)
  checkOutLongitude              Decimal?                       @db.Decimal(10, 7)
  checkOutLocationAccuracyM      Int?
  checkOutDistanceFromOfficeM    Int?
  /// No-checkout fine (Step 2): owner-approved 500৳ penalty for a day the staff
  /// checked in but never checked out. Posted only after owner APPROVES the
  /// NO_CHECKOUT_FINE approval — never automatic.
  noCheckoutFineAmount           Decimal?                       @db.Decimal(12, 2)
  noCheckoutFineLedgerEntryId    String?
  trustStatus                    AttendanceTrustStatus          @default(TRUSTED)
  suspiciousReasons              String[]
  verificationRequired           Boolean                        @default(false)
  verificationRequestedById      String?
  /// Front-camera face verification at check-in (lightweight thumb only stored).
  faceVerified                   Boolean                        @default(false)
  faceVerifiedAt                 DateTime?
  faceThumbDataUrl               String?                        @db.Text
  isArchived                     Boolean                        @default(false)
  archivedAt                     DateTime?
  archivedById                   String?
  archiveBatchId                 String?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  waiverRequests                 AttendanceWaiverRequest[]
  selfieVerifications            AttendanceSelfieVerification[]

  @@unique([businessId, employeeId, attendanceDate])
  @@index([businessId, isArchived, attendanceDate])
  @@index([businessId, attendanceDate])
  @@index([userId, attendanceDate])
  @@index([businessId, status, attendanceDate])
  @@index([businessId, trustStatus, attendanceDate])
  @@index([businessId, verificationRequired, attendanceDate])
  @@index([businessId, employeeId, attendanceDate])
  @@index([businessId, userId, attendanceDate])
  @@index([businessId, employeeId, deviceKey])
  @@index([businessId, checkInAt])
  @@index([penaltyLedgerEntryId])
}

model AttendanceSelfieVerification {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  businessId         String
  userId             String
  user               User             @relation("AttendanceSelfieUser", fields: [userId], references: [id], onDelete: Cascade)
  employeeId         String
  deviceKey          String?
  imageDataUrl       String           @db.Text
  contentType        String           @default("image/jpeg")
  sizeBytes          Int              @default(0)
  capturedAt         DateTime         @default(now())
  reviewedAt         DateTime?
  reviewedById       String?
  reviewNote         String?          @db.Text
  createdAt          DateTime         @default(now())

  @@index([businessId, capturedAt])
  @@index([businessId, employeeId, capturedAt])
  @@index([attendanceRecordId, capturedAt])
  @@index([userId])
}

model AttendanceWaiverRequest {
  id                       String                      @id @default(cuid())
  attendanceRecordId       String
  attendanceRecord         AttendanceRecord            @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  businessId               String
  userId                   String
  requester                User                        @relation("AttendanceWaiverRequester", fields: [userId], references: [id], onDelete: Cascade)
  employeeId               String
  status                   AttendanceWaiverStatus      @default(PENDING)
  requestType              AttendanceWaiverRequestType @default(FULL_WAIVE)
  originalPenaltyAmount    Decimal                     @default(0) @db.Decimal(12, 2)
  requestedReductionAmount Decimal?                    @db.Decimal(12, 2)
  approvedReductionAmount  Decimal?                    @db.Decimal(12, 2)
  reason                   String                      @db.Text
  attachmentDataUrl        String?                     @db.Text
  adminNote                String?                     @db.Text
  reviewedById             String?
  reviewer                 User?                       @relation("AttendanceWaiverReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt               DateTime?
  reversalLedgerEntryId    String?
  /// Id of the original PENALTY ledger entry this appeal contests — lets the
  /// wallet show appeal status directly on the fine transaction.
  penaltyLedgerEntryId     String?
  isArchived               Boolean                     @default(false)
  archivedAt               DateTime?
  archivedById             String?
  archiveBatchId           String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  // A staff member may appeal a specific posted penalty only once. The partial
  // unique index is created in SQL because legacy rows can have a null ledger
  // link; new submissions always require the exact PENALTY ledger entry.
  @@index([attendanceRecordId, userId])
  @@index([businessId, isArchived, createdAt])
  @@index([businessId, status, createdAt])
  @@index([businessId, employeeId, createdAt])
  @@index([businessId, userId, createdAt])
  @@index([reviewedById])
  @@index([reversalLedgerEntryId])
  @@index([penaltyLedgerEntryId])
}

/// Attendance exception / permission (Step 3, ALMA_LIFESTYLE only). A staff
/// asks the owner — one click — to waive the day's attendance rules (early
/// checkout, field work, late start, etc). Once the owner APPROVES, every
/// checkout gate (time/location/task) and the no-checkout fine are skipped for
/// that staff on that day. An optional hour window (startMinutes/endMinutes)
/// narrows the waiver to part of the day; null = whole day.
model AttendanceException {
  id             String                    @id @default(cuid())
  businessId     String
  userId         String
  employeeId     String
  attendanceDate DateTime
  status         AttendanceExceptionStatus @default(PENDING)
  /// Purpose of the waiver: FULL_DAY (all rules), EARLY_CHECKOUT (leave before
  /// 8 PM / field work), or LATE_ARRIVAL (came in late). A LATE_ARRIVAL waiver
  /// must NOT unlock an early checkout — see hasApprovedException.
  scope          String                    @default("FULL_DAY")
  startMinutes   Int?
  endMinutes     Int?
  reason         String                    @db.Text
  grantedDirect  Boolean                   @default(false)
  adminNote      String?                   @db.Text
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([businessId, userId, attendanceDate])
  @@index([businessId, attendanceDate])
  @@index([businessId, status, attendanceDate])
  @@index([businessId, employeeId, attendanceDate])
}

/// Attendance leave application (Step 4, ALMA_LIFESTYLE only). A staff applies
/// for leave — a single day, a date range, a few hours, or a shifted start
/// (e.g. begin 11:00 instead of 9:30) — and the owner approves (or grants
/// directly). While an APPROVED leave covers a day, the checkout gates are
/// waived and the late / no-checkout fines do not apply. HOURS / SHIFTED_START
/// leaves waive the day's fines but do NOT excuse a missed checkout, so the
/// no-checkout sweep still applies to them.
model AttendanceLeave {
  id            String                @id @default(cuid())
  businessId    String
  userId        String
  employeeId    String
  kind          AttendanceLeaveKind   @default(FULL_DAY)
  startDate     DateTime
  endDate       DateTime
  startMinutes  Int?
  endMinutes    Int?
  status        AttendanceLeaveStatus @default(PENDING)
  reason        String                @db.Text
  grantedDirect Boolean               @default(false)
  adminNote     String?               @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([businessId, userId, startDate])
  @@index([businessId, status, startDate])
  @@index([businessId, employeeId, startDate])
}

model PayrollAccrualRun {
  id            String                  @id @default(cuid())
  businessId    String
  periodYm      String
  trigger       String                  @default("manual")
  status        PayrollAccrualRunStatus
  employeeCount Int                     @default(0)
  createdCount  Int                     @default(0)
  skippedCount  Int                     @default(0)
  error         String?                 @db.Text
  runById       String?
  startedAt     DateTime                @default(now())
  finishedAt    DateTime?
  createdAt     DateTime                @default(now())

  @@unique([businessId, periodYm])
  @@index([status])
  @@index([businessId, createdAt])
}

model PayrollAutomationSetting {
  id                    String   @id @default("global")
  enabled               Boolean  @default(true)
  dayOfMonth            Int      @default(10)
  /// Businesses temporarily excluded from payroll runs (owner: Trading is off).
  heldBusinessIds       String[] @default([])
  timezone              String   @default("Asia/Dhaka")
  retryAfterMinutes     Int      @default(60)
  notifyAdminsOnFailure Boolean  @default(true)
  updatedById           String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

model PayrollCompensationSetting {
  id                               String   @id @default(cuid())
  businessId                       String   @unique
  commissionEnabled                Boolean  @default(true)
  commissionMode                   String   @default("FIXED")
  fixedCommissionPerDeliveredOrder Decimal  @default(0) @db.Decimal(12, 2)
