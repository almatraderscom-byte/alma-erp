  activatedAt       DateTime?            @map("activated_at")
  revokedAt         DateTime?            @map("revoked_at")
  providerDeletedAt DateTime?            @map("provider_deleted_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  audits            CreativeVoiceAudit[]

  @@unique([voiceId, version])
  @@unique([voiceId, providerVoiceId])
  @@index([voiceId, createdAt(sort: Desc)])
  @@index([status])
  @@map("creative_voice_versions")
}

model CreativeVoiceAudit {
