/// Postgres-backed expense ledger for the GAS-migrated businesses
/// (ALMA_LIFESTYLE / CREATIVE_DIGITAL_IT). TRADING keeps its own TradingExpense.
/// Amounts are whole taka (BDT) per the money rule — no decimals.
model LifestyleExpense {
  id            String    @id @default(cuid())
  businessId    String
  expenseDate   DateTime
  category      String
  subCat        String?
  expType       String?
  title         String?
  description   String?   @db.Text
  vendor        String?
  amount        Int
  paymentMethod String?
  paymentStatus String?
  recurring     Boolean   @default(false)
  notes         String?   @db.Text
  receiptRef    String?   @db.Text
  attachmentId  String?
  createdById   String?
  createdByName String?
  /// GAS Expense Ledger row id — makes backfill + dual-write idempotent (no double-count).
  legacySheetId String?   @unique
  source        String    @default("erp")
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([businessId, deletedAt, expenseDate(sort: Desc)])
  @@index([businessId, category])
  @@index([businessId, expType])
}

/// Office petty-cash fund for ALMA_LIFESTYLE — a single shared cash pool the owner
/// tops up, and admins draw office advances from. The balance is DERIVED from this
/// append-only ledger (whole-taka BDT, per the money rule). This is distinct from
/// the per-staff wallet (EmployeeLedgerEntry); office money is not a staff's salary.
model OfficeFundEntry {
  id            String    @id @default(cuid())
  businessId    String    @default("ALMA_LIFESTYLE")
  /// TOP_UP / RETURN_IN raise the fund; ADVANCE_OUT / EXPENSE lower it; ADJUSTMENT is signed.
  type          String
  /// Whole taka. Positive magnitude; direction comes from `type`. ADJUSTMENT may be negative.
  amount        Int
  note          String?   @db.Text
  /// Optional link to what drove the entry (e.g. office advance id, expense id).
  refType       String?
  refId         String?
  createdById   String?
  createdByName String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([businessId, deletedAt, createdAt(sort: Desc)])
  @@index([businessId, type])
  @@index([refType, refId])
}

/// An office-fund advance an admin draws for office work. The owner sends the
/// money manually (bKash/cash) on approval; it stays the company's money until
/// reconciled (spent + leftover). Distinct from the staff wallet — never salary.
model OfficeAdvance {
  id                  String    @id @default(cuid())
  businessId          String    @default("ALMA_LIFESTYLE")
  /// The admin who requested + received the advance (HR employee id).
  employeeId          String
  userId              String?
  requestedByName     String?
  /// Whole taka requested / disbursed.
  amount              Int
  /// Why the cash is needed (office work description).
  purpose             String?   @db.Text
  /// Where the owner sends the money manually — display label + number.
  payoutMethod        String?
  payoutNumber        String?
  /// PENDING → OUTSTANDING (approved, owner sent) → SETTLED (reconciled);
  /// or REJECTED / CANCELLED. Outstanding advances show on the admin's My Desk.
  status              String    @default("PENDING")
  /// Reconciliation outcome (Phase D): how much was actually spent + leftover,
  /// and how the leftover was returned (WALLET_DEDUCT | CASH_RETURN).
  spentAmount         Int?
  leftoverAmount      Int?
  leftoverMethod      String?
  /// Links to the approval requests that drove the advance and its reconcile.
  approvalId          String?
  reconcileApprovalId String?
  approvedById        String?
  approvedAt          DateTime?
  settledAt           DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([businessId, status, createdAt(sort: Desc)])
  @@index([employeeId, status])
  @@index([userId, status])
}

