}

model CreativeAssetReviewEvent {
  id                        String                      @id @default(uuid())
  assetId                   String                      @map("asset_id")
  asset                     CreativeProjectAsset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  brandProfileId            String                      @map("brand_profile_id")
  brandProfile              CreativeBrandProfile        @relation(fields: [brandProfileId], references: [id], onDelete: Restrict)
  sequence                  Int
  fromState                 CreativeAssetReviewState?   @map("from_state")
  toState                   CreativeAssetReviewState    @map("to_state")
  actorId                   String                      @map("actor_id")
  actor                     User                        @relation("CreativeReviewEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorRole                 CreativeStudioRole          @map("actor_role")
  note                      String?                     @db.Text
  compositionId             String?                     @map("composition_id")
  compositionVersionId      String?                     @map("composition_version_id")
  compositionVersion        Int?                        @map("composition_version")
  compositionDocumentHash   String?                     @map("composition_document_hash")
  approvedArtifactVersionId String?                     @map("approved_artifact_version_id")
  approvedArtifactVersion   CreativeAssetVersion?       @relation("CreativeReviewApprovedArtifact", fields: [approvedArtifactVersionId], references: [id], onDelete: Restrict)
  composition               CreativeComposition?        @relation("CreativeReviewComposition", fields: [compositionId], references: [id], onDelete: Restrict)
  compositionVersionRecord  CreativeCompositionVersion? @relation("CreativeReviewCompositionVersion", fields: [compositionVersionId, compositionId, compositionVersion, compositionDocumentHash], references: [id, compositionId, version, documentHash], onDelete: Restrict)
  lifecycleJobs             CreativeLifecycleJob[]
  publishDeliveries         CreativePublishDelivery[]
  metadata                  Json                        @default("{}")
  createdAt                 DateTime                    @default(now()) @map("created_at")

  @@unique([assetId, sequence])
  @@index([brandProfileId, createdAt])
  @@index([actorId, createdAt])
  @@index([compositionId, compositionVersionId])
  @@index([approvedArtifactVersionId])
  @@map("creative_asset_review_events")
}

enum CreativeLifecycleJobKind {
  RENDER
  EXPORT
}

enum CreativeLifecycleJobStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  CANCELED
  NEEDS_REVIEW
}

enum CreativeLifecycleEffectClass {
  ZERO_COST_LOCAL
  PAID
}

model CreativeLifecycleJob {
  id                        String                        @id @default(uuid())
  ownerId                   String                        @map("owner_id")
  owner                     User                          @relation("CreativeLifecycleJobOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  brandProfileId            String                        @map("brand_profile_id")
  brandProfile              CreativeBrandProfile          @relation("CreativeLifecycleJobBrandScope", fields: [brandProfileId, ownerId], references: [id, ownerId], onDelete: Restrict)
  projectId                 String                        @map("project_id")
  project                   CreativeProject               @relation("CreativeLifecycleJobProjectScope", fields: [projectId, ownerId, brandProfileId], references: [id, ownerId, brandProfileId], onDelete: Restrict)
  compositionId             String                        @map("composition_id")
  composition               CreativeComposition           @relation("CreativeLifecycleJobComposition", fields: [compositionId, ownerId, brandProfileId, projectId], references: [id, ownerId, brandProfileId, projectId], onDelete: Restrict)
  compositionVersionId      String                        @map("composition_version_id")
  compositionVersionRecord  CreativeCompositionVersion    @relation("CreativeLifecycleJobCompositionVersion", fields: [compositionVersionId, compositionId, compositionVersion, compositionDocumentHash], references: [id, compositionId, version, documentHash], onDelete: Restrict)
  compositionVersion        Int                           @map("composition_version")
  compositionDocumentHash   String                        @map("composition_document_hash")
  operationBatchId          String?                       @map("operation_batch_id")
  operationBatch            CreativeOperationBatch?       @relation("CreativeLifecycleJobOperationBatch", fields: [operationBatchId, compositionId, compositionVersion], references: [id, compositionId, resultVersion], onDelete: Restrict)
  sourceArtifactVersionId   String                        @map("source_artifact_version_id")
  sourceArtifactVersion     CreativeAssetVersion          @relation("CreativeLifecycleSourceArtifact", fields: [sourceArtifactVersionId], references: [id], onDelete: Restrict)
  sourceStoragePath         String                        @map("source_storage_path") @db.Text
  sourceChecksum            String                        @map("source_checksum")
  sourceBytes               BigInt                        @map("source_bytes")
  approvedReviewEventId     String?                       @map("approved_review_event_id")
  approvedReviewEvent       CreativeAssetReviewEvent?     @relation(fields: [approvedReviewEventId], references: [id], onDelete: Restrict)
  approvedArtifactVersionId String?                       @map("approved_artifact_version_id")
  approvedArtifactVersion   CreativeAssetVersion?         @relation("CreativeLifecycleApprovedArtifact", fields: [approvedArtifactVersionId], references: [id], onDelete: Restrict)
  reviewFingerprint         String?                       @map("review_fingerprint")
  kind                      CreativeLifecycleJobKind
  renderProfile             String                        @map("render_profile")
  outputFormat              String                        @map("output_format")
  rendererVersion           String                        @map("renderer_version")
  renderFingerprint         String                        @map("render_fingerprint")
  idempotencyKey            String                        @map("idempotency_key")
  requestFingerprint        String                        @map("request_fingerprint")
  effectClass               CreativeLifecycleEffectClass  @default(ZERO_COST_LOCAL) @map("effect_class")
  estimatedCostBdt          Int                           @default(0) @map("estimated_cost_bdt")
  paidExecutionAllowed      Boolean                       @default(false) @map("paid_execution_allowed")
  status                    CreativeLifecycleJobStatus    @default(QUEUED)
  progressCompleted         Int                           @default(0) @map("progress_completed")
  progressTotal             Int                           @default(4) @map("progress_total")
  attempts                  Int                           @default(0)
  leaseToken                String?                       @unique @map("lease_token")
  leaseExpiresAt            DateTime?                     @map("lease_expires_at")
  resultStoragePath         String?                       @map("result_storage_path") @db.Text
  resultChecksum            String?                       @map("result_checksum")
  resultBytes               BigInt?                       @map("result_bytes")
  resultArtifactVersionId   String?                       @unique @map("result_artifact_version_id")
  resultArtifactVersion     CreativeAssetVersion?         @relation("CreativeLifecycleResultArtifact", fields: [resultArtifactVersionId], references: [id], onDelete: Restrict)
  verifiedAt                DateTime?                     @map("verified_at")
  lastErrorCode             String?                       @map("last_error_code")
  lastErrorMessage          String?                       @map("last_error_message") @db.Text
  createdById               String                        @map("created_by_id")
  createdBy                 User                          @relation("CreativeLifecycleJobCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdByRole             CreativeStudioRole            @map("created_by_role")
  createdAt                 DateTime                      @default(now()) @map("created_at")
  updatedAt                 DateTime                      @updatedAt @map("updated_at")
  receipts                  CreativeLifecycleReceipt[]
  auditEvents               CreativeLifecycleAuditEvent[]

  @@unique([ownerId, idempotencyKey])
  @@unique([ownerId, renderFingerprint])
  @@index([status, createdAt])
  @@index([brandProfileId, projectId, createdAt(sort: Desc)])
  @@index([compositionId, compositionVersion, createdAt(sort: Desc)])
  @@index([renderFingerprint])
  @@index([compositionVersionId, compositionId])
  @@index([operationBatchId, compositionId, compositionVersion])
  @@index([sourceArtifactVersionId])
  @@index([approvedReviewEventId])
  @@index([approvedArtifactVersionId])
  @@index([resultArtifactVersionId])
  @@index([createdById])
  @@map("creative_lifecycle_jobs")
}

model CreativeLifecycleReceipt {
  id                       String                     @id @default(uuid())
  jobId                    String                     @map("job_id")
  job                      CreativeLifecycleJob       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  status                   CreativeLifecycleJobStatus
  storagePath              String?                    @map("storage_path") @db.Text
  checksum                 String?
  sizeBytes                BigInt?                    @map("size_bytes")
  artifactVerified         Boolean                    @default(false) @map("artifact_verified")
  artifactVersionId        String?                    @map("artifact_version_id")
  artifactVersion          CreativeAssetVersion?      @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict)
  compositionDocumentHash  String                     @map("composition_document_hash")
  operationPackageChecksum String?                    @map("operation_package_checksum")
  playableProxyPath        String?                    @map("playable_proxy_path") @db.Text
  originalStoragePath      String?                    @map("original_storage_path") @db.Text
  renderStoragePath        String?                    @map("render_storage_path") @db.Text
  metadata                 Json                       @default("{}")
  createdAt                DateTime                   @default(now()) @map("created_at")

  @@index([jobId, createdAt])
  @@index([artifactVersionId])
  @@map("creative_lifecycle_receipts")
}

model CreativeLifecycleAuditEvent {
  id                 String                      @id @default(uuid())
  jobId              String                      @map("job_id")
  job                CreativeLifecycleJob        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  actorId            String                      @map("actor_id")
  actor              User                        @relation("CreativeLifecycleAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorRole          CreativeStudioRole          @map("actor_role")
  idempotencyKey     String?                     @map("idempotency_key")
  requestFingerprint String?                     @map("request_fingerprint")
  eventType          String                      @map("event_type")
  fromStatus         CreativeLifecycleJobStatus? @map("from_status")
  toStatus           CreativeLifecycleJobStatus? @map("to_status")
  metadata           Json                        @default("{}")
  createdAt          DateTime                    @default(now()) @map("created_at")

  @@unique([jobId, idempotencyKey])
  @@index([jobId, createdAt])
  @@index([actorId, createdAt])
  @@map("creative_lifecycle_audit_events")
}

model CreativeLifecycleFeatureFlag {
  /// Exact nullable owner/brand/project/role/capability uniqueness is enforced
  /// by six function-free partial indexes in the lifecycle SQL migration.
  id                    String                            @id @default(uuid())
  ownerId               String                            @map("owner_id")
  owner                 User                              @relation("CreativeLifecycleFlagOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  brandProfileId        String?                           @map("brand_profile_id")
  brandProfile          CreativeBrandProfile?             @relation("CreativeLifecycleFlagBrandScope", fields: [brandProfileId, ownerId], references: [id, ownerId], onDelete: Restrict)
  projectId             String?                           @map("project_id")
  project               CreativeProject?                  @relation("CreativeLifecycleFlagProjectScope", fields: [projectId, ownerId, brandProfileId], references: [id, ownerId, brandProfileId], onDelete: Restrict)
  role                  CreativeStudioRole?
  capability            String
  enabled               Boolean                           @default(false)
  dualReadEnabled       Boolean                           @default(false) @map("dual_read_enabled")
  legacyFallbackEnabled Boolean                           @default(true) @map("legacy_fallback_enabled")
  canaryPercent         Int                               @default(0) @map("canary_percent")
  canarySalt            String?                           @map("canary_salt")
  updatedById           String                            @map("updated_by_id")
  updatedBy             User                              @relation("CreativeLifecycleFlagUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  auditEvents           CreativeLifecycleFlagAuditEvent[]
  createdAt             DateTime                          @default(now()) @map("created_at")
  updatedAt             DateTime                          @updatedAt @map("updated_at")

  @@index([ownerId, capability])
  @@index([brandProfileId, projectId, role])
  @@index([updatedById])
  @@map("creative_lifecycle_feature_flags")
}

model CreativeLifecycleFlagAuditEvent {
  id                 String                       @id @default(uuid())
  ownerId            String                       @map("owner_id")
  owner              User                         @relation("CreativeLifecycleFlagAuditOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  featureFlagId      String                       @map("feature_flag_id")
  featureFlag        CreativeLifecycleFeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Restrict)
  actorId            String                       @map("actor_id")
  actor              User                         @relation("CreativeLifecycleFlagAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorRole          CreativeStudioRole           @map("actor_role")
  idempotencyKey     String                       @map("idempotency_key")
  requestFingerprint String                       @map("request_fingerprint")
  eventType          String                       @map("event_type")
  before             Json?
  after              Json
  createdAt          DateTime                     @default(now()) @map("created_at")

  @@unique([ownerId, idempotencyKey])
  @@index([featureFlagId, createdAt])
  @@index([actorId, createdAt])
  @@map("creative_lifecycle_flag_audit_events")
}

// ─── Creative Studio V3 Phase 1: composition and command foundation ────────
// The mutable header points at an immutable, append-only version ledger. The
// document is provider-neutral: generated media enters only through canonical
// CreativeAssetVersion references, preserving the CSE-A/CSE8 result contracts.

enum CreativeCompositionSourceKind {
  PROJECT_PROJECTION
  NATIVE
}

enum CreativeCompositionEffectClass {
  ZERO_COST_LOCAL
  PAID
  DESTRUCTIVE
  EXTERNAL
}

enum CreativeOperationBatchKind {
  CREATE
  APPLY
  UNDO
  REDO
  ROLLBACK
}

model CreativeComposition {
  id                         String                        @id @default(uuid())
  ownerId                    String                        @map("owner_id")
  brandProfileId             String                        @map("brand_profile_id")
  brandProfile               CreativeBrandProfile          @relation(fields: [brandProfileId, ownerId], references: [id, ownerId], onDelete: Restrict)
  projectId                  String                        @map("project_id")
  project                    CreativeProject               @relation(fields: [projectId, ownerId, brandProfileId], references: [id, ownerId, brandProfileId], onDelete: Restrict)
  title                      String
  sourceKind                 CreativeCompositionSourceKind @default(PROJECT_PROJECTION) @map("source_kind")
  schemaVersion              Int                           @default(1) @map("schema_version")
  currentVersion             Int                           @default(1) @map("current_version")
  concurrencyToken           String                        @map("concurrency_token")
  readOnly                   Boolean                       @default(false) @map("read_only")
  creationIdempotencyKey     String                        @map("creation_idempotency_key")
  creationRequestFingerprint String                        @map("creation_request_fingerprint")
  createdById                String                        @map("created_by_id")
  createdBy                  User                          @relation("CreativeCompositionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt                  DateTime                      @default(now()) @map("created_at")
  updatedAt                  DateTime                      @updatedAt @map("updated_at")
  archivedAt                 DateTime?                     @map("archived_at")
  versions                   CreativeCompositionVersion[]
  operationBatches           CreativeOperationBatch[]
  editOperations             CreativeEditOperation[]
  rollbackPoints             CreativeRollbackPoint[]
  lifecycleJobs              CreativeLifecycleJob[]        @relation("CreativeLifecycleJobComposition")
  reviewEvents               CreativeAssetReviewEvent[]    @relation("CreativeReviewComposition")
  publishDeliveries          CreativePublishDelivery[]     @relation("CreativePublishComposition")
  performanceSnapshots       CreativePerformanceSnapshot[] @relation("CreativePerformanceComposition")
  archiveReceipts            CreativeArchiveReceipt[]      @relation("CreativeArchiveComposition")

  @@unique([ownerId, creationIdempotencyKey])
  @@unique([id, ownerId, brandProfileId, projectId])
  @@index([brandProfileId, projectId, updatedAt(sort: Desc)])
