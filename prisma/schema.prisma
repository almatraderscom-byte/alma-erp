  status     String   @default("approved")
  createdAt  DateTime @default(now()) @map("created_at")
  approvedBy String?  @map("approved_by")

  @@index([staffId, startDate])
  @@map("staff_leave")
}

// ─── PHASE 6: Staff Tasks ───────────────────────────────────────────────────

model AgentStaffTask {
  id                       String                         @id @default(uuid())
  staffId                  String                         @map("staff_id")
  staff                    AgentStaff                     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  title                    String
  detail                   String?                        @db.Text
  type                     String                         @default("misc")
  productRef               String?                        @map("product_ref")
  status                   String                         @default("proposed")
  proposedFor              DateTime                       @map("proposed_for") @db.Date
  /// Owner-set deadline for this task (when it should be finished). Drives office overdue flags.
  dueAt                    DateTime?                      @map("due_at")
  completedAt              DateTime?                      @map("completed_at")
  carriedFromTaskId        String?                        @map("carried_from_task_id")
  carriedFrom              AgentStaffTask?                @relation("CarryForward", fields: [carriedFromTaskId], references: [id], onDelete: SetNull)
  carriedTasks             AgentStaffTask[]               @relation("CarryForward")
  source                   String                         @default("agent")
  verificationStatus       String                         @default("not_required") @map("verification_status")
  proofType                String?                        @map("proof_type")
  proofData                Json?                          @map("proof_data")
  reviewerNote             String?                        @map("reviewer_note") @db.Text
  redoCount                Int                            @default(0) @map("redo_count")
  contextShot              String?                        @map("context_shot") @db.Text
  // ── Office update-tracking: "update requested but not given" + escalation. ──
  /// When the owner/agent asked the staff for a progress update.
  updateRequestedAt        DateTime?                      @map("update_requested_at")
  /// Who asked: 'owner' | 'agent'.
  updateRequestedBy        String?                        @map("update_requested_by")
  updateRequestNote        String?                        @map("update_request_note") @db.Text
  /// Last time the staff actually responded with an update.
  lastStaffUpdateAt        DateTime?                      @map("last_staff_update_at")
  /// Set once the unanswered request was escalated to the owner (countdown over).
  escalatedAt              DateTime?                      @map("escalated_at")
  // ── Phase-2 DeepSeek supervisor state. ──
  /// How many clarifying questions the supervisor has asked the staff (capped at 2).
  supervisorClarifyCount   Int                            @default(0) @map("supervisor_clarify_count")
  /// Task the supervisor couldn't auto-verify/understand → owner must review (the ~10%).
  supervisorNeedsOwner     Boolean                        @default(false) @map("supervisor_needs_owner")
  /// Last time the supervisor acted on this task (debounce + re-triage marker).
  supervisorLastTickAt     DateTime?                      @map("supervisor_last_tick_at")
  // ── Phase-3 90/10 escalation gate. ──
  /// Owner forced this task to always reach him, overriding the criticality gate.
  supervisorAlwaysEscalate Boolean                        @default(false) @map("supervisor_always_escalate")
  /// Last criticality the supervisor computed ('critical' | 'normal'). Audit only.
  supervisorCriticality    String?                        @map("supervisor_criticality")
  // ── Phase-D durable follow-up schedule. ──
  /// When the supervisor should next check in on this task (deadline-aware).
  /// Durable so a follow-up survives restarts / day boundaries (not recomputed).
  nextFollowUpAt           DateTime?                      @map("next_follow_up_at")
  /// Business scope inherited from staff ('ALMA_LIFESTYLE' | 'ALMA_TRADING').
  businessId               String                         @default("ALMA_LIFESTYLE") @map("business_id")
  createdAt                DateTime                       @default(now()) @map("created_at")
  marketingHistory         AgentProductMarketingHistory[]
  officeComments           OfficeComment[]                @relation("TaskComments")
  officeEvents             OfficeTaskEvent[]              @relation("TaskEvents")

  @@index([staffId])
  @@index([proposedFor, status])
  @@index([status])
  @@index([businessId, proposedFor, status])
  @@index([businessId, dueAt])
  @@index([businessId, status, supervisorNeedsOwner])
  @@index([businessId, status, nextFollowUpAt])
  @@map("staff_tasks")
}

model AgentProductMarketingHistory {
  id             String          @id @default(uuid())
  productRef     String          @map("product_ref")
  business       String
  lastPromotedAt DateTime        @default(now()) @map("last_promoted_at")
  contentType    String?         @map("content_type")
  taskId         String?         @map("task_id")
  task           AgentStaffTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  notes          String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([productRef, lastPromotedAt(sort: Desc)])
  @@index([business, lastPromotedAt(sort: Desc)])
  @@map("product_marketing_history")
}

// ─── PHASE 6: Salah ─────────────────────────────────────────────────────────

model AgentSalahRecord {
  id            String    @id @default(uuid())
  date          DateTime  @db.Date
  waqt          String
  windowStart   DateTime  @map("window_start")
  windowEnd     DateTime  @map("window_end")
  status        String    @default("pending")
  confirmedAt   DateTime? @map("confirmed_at")
  remindersSent Int       @default(0) @map("reminders_sent")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([date, waqt])
  @@index([date(sort: Desc)])
  @@index([status])
  @@map("salah_records")
}

model AgentSalahOverride {
  id           String    @id @default(uuid())
  date         DateTime? @db.Date
  waqt         String?
  overrideTime DateTime? @map("override_time")
  delayUntil   DateTime? @map("delay_until")
  skip         Boolean   @default(false)
  reason       String?   @db.Text
